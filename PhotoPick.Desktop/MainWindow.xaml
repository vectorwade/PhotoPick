<Window x:Class="PhotoPick.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhotoPick.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="PhotoPick — Culling Ultrarrápido de Fotos (Lightroom Classic)"
        Height="820" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#181818"
        Foreground="#ECECEC"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Estilos de Botão Escuro Moderno -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#383838"/>
                    <Setter Property="BorderBrush" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#222222"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão de Ação Primária (Verde / Salvar) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#107C41"/>
            <Setter Property="BorderBrush" Value="#1E8E4F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#15934E"/>
                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Chips de Filtro -->
        <Style x:Key="FilterBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra Superior -->
            <RowDefinition Height="Auto"/> <!-- Barra de Filtros -->
            <RowDefinition Height="*"/>    <!-- Conteúdo: Grade ou Loupe -->
            <RowDefinition Height="Auto"/> <!-- Barra de Status -->
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título e Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3498DB" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="PHOTOPICK" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>
                    <Button Content="📁 Abrir Pasta..." Style="{StaticResource ToolbarBtn}" Click="BtnOpenFolder_Click"/>
                </StackPanel>

                <!-- Caminho da Pasta Atual -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="Pasta: " Foreground="#888888" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentDirectory}" Foreground="#DDDDDD" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                </StackPanel>

                <!-- Botões de Ação Direita -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔍 Alternar Visão (Espaço)" Style="{StaticResource ToolbarBtn}" Click="BtnToggleView_Click"/>
                    <Button Content="⚡ Sincronizar Lightroom (Ctrl+S)" Style="{StaticResource PrimaryBtn}" Click="BtnSaveXmp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA DE FILTROS & CONTADORES -->
        <Border Grid.Row="1" Background="#141414" BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="14,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filtro:" Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Button Style="{StaticResource FilterBtn}" Click="FilterAll_Click">
                        <TextBlock>
                            <Run Text="Todas ("/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <Button Style="{StaticResource FilterBtn}" Click="FilterPicked_Click">
                        <TextBlock Foreground="#2ECC71">
                            <Run Text="✔ Picks ("/><Run Text="{Binding PickedCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <Button Style="{StaticResource FilterBtn}" Click="FilterUnflagged_Click">
                        <TextBlock Foreground="#CCCCCC">
                            <Run Text="○ Não Avaliadas ("/><Run Text="{Binding UnflaggedCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <Button Style="{StaticResource FilterBtn}" Click="FilterRejected_Click">
                        <TextBlock Foreground="#E74C3C">
                            <Run Text="✖ Rejeitadas ("/><Run Text="{Binding RejectedCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <Button Style="{StaticResource FilterBtn}" Click="FilterRated_Click">
                        <TextBlock Foreground="#F39C12" Text="★ Com Estrelas"/>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E67E22" CornerRadius="3" Padding="6,2" Margin="6,0"
                            Visibility="{Binding UnsavedCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF">
                            <Run Text="{Binding UnsavedCount, Mode=OneWay}"/><Run Text=" alterações pendentes em XMP"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ÁREA CENTRAL: GRADE OU FOTO ÚNICA -->
        <Grid Grid.Row="2">

            <!-- MODO 1: GRADE DE FOTOS (CONTACT SHEET) -->
            <ListBox x:Name="PhotoListBox"
                     ItemsSource="{Binding Photos}"
                     SelectedItem="{Binding SelectedPhoto, Mode=TwoWay}"
                     Visibility="{Binding IsGridViewMode, Converter={StaticResource BoolToVis}}"
                     Background="#141414"
                     BorderThickness="0"
                     Padding="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="PhotoListBox_MouseDoubleClick">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="BorderBrush" Value="#252525"/>
                        <Setter Property="Background" Value="#1E1E1E"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="4">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#555555"/>
                                <Setter Property="Background" Value="#242424"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#3498DB"/>
                                <Setter Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PhotoViewModel}">
                        <Border Width="220" Height="230" Background="#1A1A1A" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>    <!-- Imagem -->
                                    <RowDefinition Height="Auto"/> <!-- Metadados -->
                                </Grid.RowDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Row="0" Background="#111111">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <!-- Badge de Seleção (Pick / Reject) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                Background="{Binding StatusBadgeColor}"
                                                CornerRadius="3" Padding="4,2">
                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FFFFFF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                                <Setter Property="Text" Value="PICK"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                                <Setter Property="Text" Value="REJECT"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Badge de Estrelas -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                Background="#99000000" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding RatingStars}" Foreground="#F39C12" FontSize="10"/>
                                        </Border>

                                        <!-- Faixa de Cor / Label -->
                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="3"
                                                Background="{Binding LabelBrush}"/>
                                    </Grid>
                                </Border>

                                <!-- Informações do Arquivo -->
                                <Border Grid.Row="1" Background="#202020" Padding="6,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FileName}" Foreground="#E0E0E0" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" Foreground="#888888" FontSize="10" Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- MODO 2: FOTO ÚNICA (LOUPE VIEW) -->
            <Grid Visibility="{Binding IsSingleViewMode, Converter={StaticResource BoolToVis}}" Background="#0D0D0D">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Overlay superior com dados da foto -->
                    <RowDefinition Height="*"/>    <!-- Imagem em tela cheia -->
                </Grid.RowDefinitions>

                <!-- Barra de Informações da Foto Única -->
                <Border Grid.Row="0" Background="#CC181818" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPhoto.FileName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedPhoto.Extension}" Foreground="#3498DB" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedPhoto.FormattedSize}" Foreground="#888888" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Indicador de Status Central -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPhoto.RatingStars}" Foreground="#F39C12" FontSize="16" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border Background="{Binding SelectedPhoto.StatusBadgeColor}" CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                                <TextBlock Text="{Binding SelectedPhoto.IsPicked, Converter={StaticResource BoolToVis}}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <!-- Botão para voltar à grade -->
                        <Button Grid.Column="2" Content="✕ Fechar Loupe (Espaço)" Style="{StaticResource ToolbarBtn}" Click="BtnToggleView_Click"/>
                    </Grid>
                </Border>

                <!-- Imagem em Alta Resolução -->
                <Image Grid.Row="1"
                       Source="{Binding LoupeImage}"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="10"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <!-- Overlay de Carregamento -->
            <Grid Background="#B3000000" Visibility="{Binding IsLoadingFolder, Converter={StaticResource BoolToVis}}">
                <Border Background="#252525" CornerRadius="8" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="6" Margin="0,0,0,12" Foreground="#3498DB"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- BARRA DE STATUS E ATALHOS INFERIOR -->
        <Border Grid.Row="3" Background="#111111" BorderBrush="#222222" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Mensagem de Status -->
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>

                <!-- Guia Rápido de Atalhos -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#777777" FontSize="10">
                        <Run Text="ATALHOS: " FontWeight="Bold" Foreground="#999999"/>
                        <Run Text="[P] Pick  |  "/>
                        <Run Text="[X] Reject  |  "/>
                        <Run Text="[U] Limpar  |  "/>
                        <Run Text="[1-5] Estrelas  |  "/>
                        <Run Text="[0] Sem Estrelas  |  "/>
                        <Run Text="[Setas] Navegar  |  "/>
                        <Run Text="[Espaço] Loupe  |  "/>
                        <Run Text="[Ctrl+S] Sincronizar"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
