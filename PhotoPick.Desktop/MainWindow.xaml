<Window x:Class="PhotoPick.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoPick.Desktop"
        xmlns:vm="clr-namespace:PhotoPick.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Mavi Select"
        Height="840" Width="1360"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BgWorkspace}"
        Foreground="{DynamicResource TextNormal}"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ESTILO BOTÃO TOOLBAR DISCRETO -->
        <Style x:Key="IdeToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#252525"/>
                                <Setter Property="BorderBrush" TargetName="bd" Value="#333333"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#1A1A1A"/>
                                <Setter Property="BorderBrush" TargetName="bd" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO CAPTION (MIN, MAX, CLOSE) -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÃO FECHAR CAPTION COM HOVER VERMELHO -->
        <Style x:Key="CloseCaptionBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#C0392B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO DE AÇÃO PRIMÁRIA VERDE -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0A1810"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#38E580"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#27AE60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO LATERAL NAVEGAÇÃO -->
        <Style x:Key="NavListBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#252525"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#1E1E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BgWorkspace}">
        <Grid.RowDefinitions>
            <!-- 0: Header / TitleBar customizada (38px) -->
            <RowDefinition Height="38"/>
            <!-- 1: Área de Conteúdo (Workspace ou Overlay) -->
            <RowDefinition Height="*"/>
            <!-- 2: Status Bar Inferior (28px) -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 0: HEADER / TOP BAR INTEGRADA (ESTILO IDE CURSOR/ANTIGRAVITY)  -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Logo / Home (Esquerda) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Barra de Ações Rápidas (Centro) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Controles de Janela (Direita) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Botão Home / Logo Mavi Select -->
                <Button Grid.Column="0" Click="LogoHome_Click"
                        Style="{StaticResource IdeToolBtn}" Padding="8,4" Margin="6,0"
                        ToolTip="Mavi Select • Clique para ir à Tela Inicial / Iniciar Projeto">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="app_icon.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Mavi Select" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Ações Rápidas Centrais (Alternar Visão, Auto-Advance, Lr, Export, Ajuda) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <!-- Alternar Visão Grade / Loupe -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnViewMode_Click" Margin="0,0,4,0"
                            ToolTip="Alternar entre Grade e Foto Única (Espaço ou Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding IsSingleViewMode, Converter={x:Null}, StringFormat='🔍 {0}'}" FontSize="11.5" Foreground="{DynamicResource TextNormal}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⊞ Grade"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSingleViewMode}" Value="True">
                                                <Setter Property="Text" Value="🔍 Zoom"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Auto-Advance Toggle -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnAutoAdvance_Click" Margin="0,0,4,0"
                            ToolTip="Avançar automaticamente para a próxima foto ao votar (Pick/Reject/Nota)">
                        <TextBlock Text="{Binding AutoAdvanceLabel, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource TextNormal}"/>
                    </Button>

                                        <!-- Alternar Tema Claro / Escuro -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnToggleTheme_Click" Margin="0,0,4,0"
                            ToolTip="Alternar entre Modo Escuro e Modo Claro">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ThemeToggleIcon, Mode=OneWay}" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ThemeToggleText, Mode=OneWay}" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="18" Background="#2B2B2B" Margin="6,0"/>

                    <!-- Sincronizar / Enviar Lightroom -->
                    <Button Style="{StaticResource PrimaryActionBtn}" Click="BtnLightroom_Click" Margin="0,0,4,0"
                            ToolTip="Enviar fotos selecionadas diretamente para o Adobe Lightroom Classic">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Lr Sincronizar" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Exportar Selecionadas -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnExport_Click" Margin="0,0,4,0"
                            ToolTip="Copiar apenas as fotos selecionadas para uma nova pasta ou pendrive">
                        <TextBlock Text="💾 Exportar" FontSize="11.5"/>
                    </Button>

                    <Separator Width="1" Height="18" Background="#2B2B2B" Margin="6,0"/>

                    <!-- Ajuda e Guia -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnHelp_Click"
                            ToolTip="Guia de Recursos, Atalhos de Teclado e Gamepad (F1 ou H)">
                        <TextBlock Text="❓ Ajuda" FontSize="11.5"/>
                    </Button>
                </StackPanel>

                <!-- Controles da Janela (Min, Max, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtn}" Click="BtnMinimize_Click" ToolTip="Minimizar">
                        <TextBlock Text="🗕" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="BtnMaximize_Click" ToolTip="Maximizar / Restaurar">
                        <TextBlock Text="🗖" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionBtn}" Click="BtnClose_Click" ToolTip="Fechar">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 1: ÁREA PRINCIPAL (LAYOUT BASE DE 3 PAINÉIS)                   -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Painel Esquerdo: Navegação / Pastas (250px) -->
                <ColumnDefinition Width="250" MinWidth="180" MaxWidth="380"/>
                <!-- Divisor Redimensionável -->
                <ColumnDefinition Width="1"/>
                <!-- Área Central: Workspace (Expansível *) -->
                <ColumnDefinition Width="*"/>
                <!-- Divisor Redimensionável -->
                <ColumnDefinition Width="1"/>
                <!-- Painel Direito: Inspetor EXIF & Qualidade (300px) -->
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="450"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================== -->
            <!-- PAINEL ESQUERDO: NAVEGAÇÃO DE DIRETÓRIOS E SESSÕES (250px) -->
            <!-- ========================================================== -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0">
                <DockPanel Margin="12,14,12,12">
                    <!-- Cabeçalho do Painel -->
                    <TextBlock DockPanel.Dock="Top" Text="EXPLORADOR" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" Margin="4,0,0,10"/>

                    <!-- Cartão da Pasta Ativa -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📁 " FontSize="12"/>
                                <TextBlock Text="{Binding CurrentDirectoryName, Mode=OneWay}" FontWeight="SemiBold"
                                           FontSize="12" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentDirectoryPath, Mode=OneWay}" FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentDirectoryPath, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- Botão Abrir Pasta -->
                    <Button DockPanel.Dock="Top" Style="{StaticResource IdeToolBtn}" Click="BtnOpenFolder_Click"
                            Background="#252525" BorderBrush="#333333" Margin="0,0,0,16" Padding="10,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📂 " FontSize="12"/>
                            <TextBlock Text="Abrir Nova Pasta..." FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <!-- Filtros Rápidos de Seleção -->
                    <TextBlock DockPanel.Dock="Top" Text="FILTROS DE STATUS" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" Margin="4,0,0,6"/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button Style="{StaticResource NavListBtn}" Click="FilterAll_Click">
                            <DockPanel LastChildFill="True" Width="210">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalCount, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock Text="Todas as Fotos" Foreground="{DynamicResource TextNormal}"/>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource NavListBtn}" Click="FilterPicked_Click">
                            <DockPanel LastChildFill="True" Width="210">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PickedCount, Mode=OneWay}" Foreground="#2ECC71" FontWeight="Bold" FontSize="11"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✔ " Foreground="#2ECC71"/>
                                    <TextBlock Text="Selecionadas" Foreground="#2ECC71"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource NavListBtn}" Click="FilterRejected_Click">
                            <DockPanel LastChildFill="True" Width="210">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RejectedCount, Mode=OneWay}" Foreground="#E74C3C" FontWeight="Bold" FontSize="11"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✖ " Foreground="#E74C3C"/>
                                    <TextBlock Text="Rejeitadas" Foreground="#E74C3C"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource NavListBtn}" Click="FilterUnflagged_Click">
                            <DockPanel LastChildFill="True" Width="210">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding UnflaggedCount, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                <TextBlock Text="○ Não Avaliadas" Foreground="{DynamicResource TextMuted}"/>
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <!-- Seção: Agrupamento por Formatos de Arquivo de Imagem -->
                    <TextBlock DockPanel.Dock="Top" Text="FORMATOS DE ARQUIVO" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" Margin="4,0,0,6"/>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Formats}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavListBtn}" Click="FormatItem_Click" Margin="0,1">
                                    <DockPanel LastChildFill="True" Width="210">
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource BgCardHover}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextNormal}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Resumo da Sessão / Métricas Rápidas no Rodapé do Painel -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="RESUMO DA SESSÃO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <TextBlock Text="Total Indexadas:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding TotalCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Picks (Escolhas):" FontSize="11" Foreground="#2ECC71"/>
                                <TextBlock Text="{Binding PickedCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#2ECC71"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Rejeitadas:" FontSize="11" Foreground="#E74C3C"/>
                                <TextBlock Text="{Binding RejectedCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#E74C3C"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Pendentes XMP:" FontSize="11" Foreground="#F39C12"/>
                                <TextBlock Text="{Binding UnsavedCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#F39C12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Espaço vazio expansível -->
                    <Grid/>
                </DockPanel>
            </Border>

            <!-- Splitter Esquerdo -->
            <GridSplitter Grid.Column="1" Width="1" Background="#2B2B2B" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- ========================================================== -->
            <!-- ÁREA CENTRAL: WORKSPACE DE FOTOS (#141414)                 -->
            <!-- ========================================================== -->
            <Grid Grid.Column="2" Background="{DynamicResource BgWorkspace}">
                <!-- Modo Grade de Fotos -->
                <ScrollViewer x:Name="GridScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              Visibility="{Binding IsGridViewMode, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  Padding="12,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- CARD DA FOTO (ESTILO MINIMALISTA COM AURA) -->
                                            <Border Width="250" Height="265" Margin="7,7"
                                                    Background="{DynamicResource BgCard}"
                                                    CornerRadius="6"
                                                    BorderBrush="{Binding CardBorderBrush}"
                                                    BorderThickness="{Binding CardBorderThickness}"
                                                    Effect="{Binding AuraEffect}"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="PhotoCard_MouseLeftButtonDown">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <!-- 0: Imagem e Badges Contextuais Flutuantes -->
                                                        <RowDefinition Height="185"/>
                                                        <!-- 1: Informações e Controles Rápidos -->
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Imagem da Foto -->
                                                    <Border Grid.Row="0" Background="#111111" CornerRadius="6,6,0,0" ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding Thumbnail}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"/>

                                                            <!-- Mini Badges Contextuais Flutuantes (Aparecem apenas se aplicável) -->
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8">
                                                                <!-- Defeito de Nitidez / Foco -->
                                                                <Border Background="#B39B59B6" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                                                        Visibility="{Binding IsBlurry, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="Foto identificada como Fora de Foco / Embaçada">
                                                                    <TextBlock Text="🌫️ Embaçada" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                                <!-- Subexposição -->
                                                                <Border Background="#B32C3E50" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                                                        Visibility="{Binding IsUnderexposed, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="Foto identificada como Muito Escura (Subexposta)">
                                                                    <TextBlock Text="🌑 Escura" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                                <!-- Hiperexposição -->
                                                                <Border Background="#B3E67E22" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                                                        Visibility="{Binding IsOverexposed, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="Foto identificada como Muito Clara (Estourada)">
                                                                    <TextBlock Text="☀️ Clara" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Badge de Rajada (Burst) no Canto Superior Direito -->
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,8"
                                                                    Background="#B32980B9" CornerRadius="4" Padding="5,2"
                                                                    Visibility="{Binding IsInBurst, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Foto pertencente a uma sequência rápida de disparos">
                                                                <TextBlock Text="{Binding BurstBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>

                                                            <!-- Badge de Status Pick / Reject no Canto Inferior Esquerdo -->
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,8"
                                                                    Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2"
                                                                    Visibility="{Binding IsPicked, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="✔ PICK" FontSize="9" FontWeight="Bold" Foreground="#000000"/>
                                                            </Border>
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,8"
                                                                    Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2"
                                                                    Visibility="{Binding IsRejected, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="✖ REJECT" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Barra Inferior do Card (Metadados e Ações) -->
                                                    <Border Grid.Row="1" Background="{DynamicResource BgCard}" Padding="10,8" CornerRadius="0,0,6,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Nome do Arquivo -->
                                                            <DockPanel Grid.Row="0">
                                                                <TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right"
                                                                           FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextNormal}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                            </DockPanel>

                                                            <!-- Estrelas Clicáveis e Botões Rápidos -->
                                                            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                                                <!-- Botões Rápidos de Voto no Card -->
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Button Style="{StaticResource IdeToolBtn}" Padding="5,2" Margin="2,0,0,0"
                                                                            Click="CardBtnPick_Click" ToolTip="Marcar como Escolhida [P]">
                                                                        <TextBlock Text="✔" Foreground="#2ECC71" FontSize="11" FontWeight="Bold"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource IdeToolBtn}" Padding="5,2" Margin="2,0,0,0"
                                                                            Click="CardBtnReject_Click" ToolTip="Marcar como Rejeitada [X]">
                                                                        <TextBlock Text="✖" Foreground="#E74C3C" FontSize="11" FontWeight="Bold"/>
                                                                    </Button>
                                                                </StackPanel>

                                                                <!-- 5 Estrelas Clicáveis -->
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="★" Foreground="{Binding Star1Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star1_Click"/>
                                                                    <TextBlock Text="★" Foreground="{Binding Star2Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star2_Click"/>
                                                                    <TextBlock Text="★" Foreground="{Binding Star3Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star3_Click"/>
                                                                    <TextBlock Text="★" Foreground="{Binding Star4Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star4_Click"/>
                                                                    <TextBlock Text="★" Foreground="{Binding Star5Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star5_Click"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Modo Loupe (Visualização de Foto Única / Zoom com Focus Peaking) -->
                <Grid Visibility="{Binding IsSingleViewMode, Converter={StaticResource BoolToVis}}" Background="#0D0D0D">
                    <!-- Camada de Imagem com Peaking -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="{Binding LoupeImage}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               MouseLeftButtonDown="LoupeImage_MouseLeftButtonDown"/>

                        <!-- Camada de Focus Peaking (Verde Neon) -->
                        <Image Source="{Binding PeakingOverlayImage}"
                               Stretch="Uniform"
                               Opacity="0.85"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasPeakingOverlay, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Barra Flutuante de Controle no Topo do Loupe -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                            Background="#D91E1E1E" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <!-- Botão Focus Peaking -->
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnFocusPeaking_Click" Margin="0,0,8,0"
                                    ToolTip="Destacar bordas em foco com contorno verde neon (Tecla F)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎯 Focus Peaking" FontSize="11.5"/>
                                </StackPanel>
                            </Button>

                            <!-- Botão Escolher Esta e Rejeitar Outras da Rajada -->
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnPickBurstBest_Click" Margin="0,0,8,0"
                                    Visibility="{Binding SelectedPhoto.IsInBurst, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Marcar esta foto como Pick e automaticamente rejeitar as outras da mesma sequência rápida">
                                <TextBlock Text="⚡ Escolher Esta e Rejeitar Outras da Rajada" FontSize="11.5" Foreground="#F39C12"/>
                            </Button>

                            <Separator Width="1" Height="16" Background="#2B2B2B" Margin="4,0,8,0"/>

                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnLoupePick_Click" Margin="0,0,4,0">
                                <TextBlock Text="✔ Escolher (P)" Foreground="#2ECC71" FontSize="11.5"/>
                            </Button>
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnLoupeReject_Click" Margin="0,0,4,0">
                                <TextBlock Text="✖ Rejeitar (X)" Foreground="#E74C3C" FontSize="11.5"/>
                            </Button>
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnLoupeClear_Click">
                                <TextBlock Text="↺ Limpar (U)" FontSize="11.5"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Splitter Direito -->
            <GridSplitter Grid.Column="3" Width="1" Background="#2B2B2B" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- ========================================================== -->
            <!-- PAINEL DIREITO: INSPETOR EXIF & QUALIDADE (#1E1E1E - 300px)-->
            <!-- ========================================================== -->
            <Border Grid.Column="4" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,14,14,14">
                        <!-- Cabeçalho do Inspetor -->
                        <TextBlock Text="INSPETOR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

                        <!-- SEÇÃO 1: FILTROS DE EQUIPAMENTO (CÂMERA E FLASH REESTILIZADOS) -->
                        <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FILTRAR POR EQUIPAMENTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                                <!-- Filtro de Câmera -->
                                <TextBlock Text="Câmera" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding CameraList}"
                                          SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                          Margin="0,0,0,10"/>

                                <!-- Filtro de Flash -->
                                <TextBlock Text="Disparo de Flash" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding FlashList}"
                                          SelectedItem="{Binding SelectedFlashFilter, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 2: DADOS DA FOTO ATIVA -->
                        <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FOTO SELECIONADA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                <!-- Miniatura Preview Grande -->
                                <Border Height="140" Background="#0A0A0A" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,10">
                                    <Image Source="{Binding SelectedPhoto.Thumbnail, Mode=OneWay}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Nome do Arquivo -->
                                <TextBlock Text="{Binding SelectedPhotoName, Mode=OneWay}"
                                           FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedPhotoDimensions, Mode=OneWay}"
                                           FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                                <!-- Grade de Metadados EXIF -->
                                <Border Background="#1A1A1A" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Câmera:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoCamera, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Flash:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoFlash, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Data / Hora:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoDate, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 3: ANÁLISE DE QUALIDADE INTELIGENTE -->
                        <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ANÁLISE DE QUALIDADE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                                <!-- Diagnóstico Geral -->
                                <TextBlock Text="{Binding SelectedPhotoQualityText, Mode=OneWay}"
                                           Foreground="{Binding SelectedPhotoQualityBrush, Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <!-- Medidor de Nitidez (Variância Laplaciana) -->
                                <TextBlock Text="Score de Nitidez (Foco)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                <ProgressBar Height="5" Maximum="100" Value="{Binding SelectedPhotoSharpnessPercent, Mode=OneWay}"
                                             Foreground="#2ECC71" Background="#252525" BorderThickness="0" Margin="0,0,0,10"/>

                                <!-- Medidor de Exposição (Luminância) -->
                                <TextBlock Text="Balanço de Exposição" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                <ProgressBar Height="5" Maximum="100" Value="{Binding SelectedPhotoBrightnessPercent, Mode=OneWay}"
                                             Foreground="#3498DB" Background="#252525" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 4: AÇÕES DE TRIAGEM RÁPIDA -->
                        <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="CLASSIFICAÇÃO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                <!-- 5 Estrelas Grandes no Inspetor -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star1Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar1_Click"/>
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star2Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar2_Click"/>
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star3Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar3_Click"/>
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star4Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar4_Click"/>
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star5Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar5_Click"/>
                                </StackPanel>

                                <!-- Botão Pick -->
                                <Button Style="{StaticResource PrimaryActionBtn}" Click="BtnInspectorPick_Click" Margin="0,0,0,6" Padding="0,9">
                                    <TextBlock Text="✔ Escolher (Pick)" FontSize="12" FontWeight="Bold"/>
                                </Button>

                                <!-- Botão Reject -->
                                <Button Style="{StaticResource IdeToolBtn}" Background="#2A1616" BorderBrush="#552222" Click="BtnInspectorReject_Click" Margin="0,0,0,6" Padding="0,8">
                                    <TextBlock Text="✖ Rejeitar (Reject)" FontSize="12" Foreground="#E74C3C" FontWeight="SemiBold"/>
                                </Button>

                                <!-- Botão Limpar -->
                                <Button Style="{StaticResource IdeToolBtn}" Click="BtnInspectorClear_Click" Padding="0,7">
                                    <TextBlock Text="↺ Limpar Seleção (Unflag)" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- 2: STATUS BAR INFERIOR (28PX)                                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel LastChildFill="True">
                <!-- Status do Gamepad e Teclado (Direita) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GamepadStatusText, Mode=OneWay}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,14,0"/>
                    <TextBlock Text="Atalhos: [P] Pick  [X] Reject  [1-5] Notas  [F] Foco  [Gamepad LB/RB/A/B]"
                               FontSize="10.5" Foreground="#666666"/>
                </StackPanel>

                <!-- Mensagem de Status da Aplicação (Esquerda) -->
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- OVERLAY: WELCOME SCREEN / INICIALIZAÇÃO                        -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Background="#F2141414"
              Visibility="{Binding IsWelcomeScreenVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="36" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Logotipo Oficial Mavi Select -->
                    <Image Source="app_icon.png" Width="76" Height="76" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Título Oficial -->
                    <TextBlock Text="Mavi Select" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <!-- Descrição Elegante -->
                    <TextBlock Text="Triagem ultrarrápida de fotos para criadores e fotógrafos"
                               FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Botão Principal Verde: Iniciar Novo Projeto (Abrir Pasta) -->
                    <Button Style="{StaticResource PrimaryActionBtn}" Click="BtnWelcomeOpenFolder_Click"
                            Padding="24,12" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📂 " FontSize="14"/>
                            <TextBlock Text="Iniciar Novo Projeto (Abrir Pasta)" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Botão Retornar à Sessão (se houver fotos carregadas) -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnWelcomeReturn_Click"
                            Visibility="{Binding Photos.Count, Converter={StaticResource BoolToVis}}"
                            Background="#252525" Padding="16,8" Margin="0,0,0,18" HorizontalAlignment="Stretch">
                        <TextBlock Text="➔ Retornar à Sessão de Trabalho Atual" FontSize="11.5" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                    </Button>

                    <TextBlock Text="Ou arraste uma pasta de fotos diretamente para esta tela"
                               FontSize="11" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Guia Rápido de Controles -->
                    <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="4,0">
                                <TextBlock Text="⌨️ TECLADO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="P: Escolher (Pick)" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                                <TextBlock Text="X: Rejeitar (Reject)" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                                <TextBlock Text="1 a 5: Classificar notas" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                                <TextBlock Text="F: Focus Peaking (Foco)" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="4,0">
                                <TextBlock Text="🎮 GAMEPAD" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="LB / RB: Foto Anterior / Próxima" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                                <TextBlock Text="Botão A: Escolher (Pick)" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                                <TextBlock Text="Botão B/X: Rejeitar (Reject)" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                                <TextBlock Text="Botão Y: Focus Peaking" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODAL DE AJUDA & ATALHOS                                       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Background="#B3000000"
              Visibility="{Binding IsHelpModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="24" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionBtn}" Click="BtnCloseHelp_Click" ToolTip="Fechar Ajuda">
                            <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                        <TextBlock Text="Central de Ajuda &amp; Atalhos — Mavi Select" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </DockPanel>

                    <TextBlock Text="O Mavi Select é uma ferramenta de triagem ultrarrápida desenhada para preparar suas seleções para o Adobe Lightroom Classic."
                               FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- Lista de Atalhos -->
                    <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ATALHOS ESSENCIAIS DE TECLADO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                            <Grid Margin="0,3"><TextBlock Text="[P]" FontWeight="Bold" Foreground="#2ECC71"/><TextBlock Text="Marcar como Pick (Aura Verde + 1 Estrela)" Margin="40,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                            <Grid Margin="0,3"><TextBlock Text="[X]" FontWeight="Bold" Foreground="#E74C3C"/><TextBlock Text="Marcar como Reject (Aura Vermelha)" Margin="40,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                            <Grid Margin="0,3"><TextBlock Text="[U]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Limpar marcações (Unflag)" Margin="40,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                            <Grid Margin="0,3"><TextBlock Text="[1 a 5]" FontWeight="Bold" Foreground="#F39C12"/><TextBlock Text="Atribuir classificação de estrelas" Margin="40,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                            <Grid Margin="0,3"><TextBlock Text="[F]" FontWeight="Bold" Foreground="#2ECC71"/><TextBlock Text="Ativar / Desativar Focus Peaking (Verde Neon)" Margin="40,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                            <Grid Margin="0,3"><TextBlock Text="[Espaço]" FontWeight="Bold" Foreground="#FFFFFF"/><TextBlock Text="Alternar entre Grade e Visualização de Foto Única" Margin="40,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                            <Grid Margin="0,3"><TextBlock Text="[Setas]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Navegar entre as fotos" Margin="40,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                        </StackPanel>
                    </Border>

                    <!-- Fechar -->
                    <Button Style="{StaticResource IdeToolBtn}" Background="#252525" Click="BtnCloseHelp_Click"
                            HorizontalAlignment="Right" Padding="18,8">
                        <TextBlock Text="Entendi, fechar ajuda" FontSize="11.5" Foreground="#FFFFFF"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
