<Window x:Class="PhotoPick.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PhotoPick.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Mavi Select"
        Icon="app_icon.ico"
        Height="860" Width="1360"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#141414"
        Foreground="#ECECEC"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        SizeChanged="Window_SizeChanged"
        ToolTipService.InitialShowDelay="400">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Estilos de Botão Escuro Moderno -->
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#353535"/>
                    <Setter Property="BorderBrush" Value="#555555"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1A1A1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Primário Verde (Lightroom) -->
        <Style x:Key="LightroomBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#0F7A3E"/>
            <Setter Property="BorderBrush" Value="#1DB954"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#149A4F"/>
                    <Setter Property="BorderBrush" Value="#2ECC71"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Exportar / Criar Pasta (Azul) -->
        <Style x:Key="ExportBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#1B5E8C"/>
            <Setter Property="BorderBrush" Value="#2980B9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2471A3"/>
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Chips de Filtro -->
        <Style x:Key="FilterChipBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2F2F2F"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <!-- Mini Botões de Card (Pick / Reject / Limpar) -->
        <Style x:Key="CardActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#282828"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardPickBtn" TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
            <Setter Property="Background" Value="#1B4D2E"/>
            <Setter Property="BorderBrush" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="#2ECC71"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2ECC71"/>
                    <Setter Property="Foreground" Value="#000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardRejectBtn" TargetType="Button" BasedOn="{StaticResource CardActionBtn}">
            <Setter Property="Background" Value="#4D1F1F"/>
            <Setter Property="BorderBrush" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E74C3C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão Estrela Individual -->
        <Style x:Key="StarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="1,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar 1: Controles Principais -->
            <RowDefinition Height="Auto"/> <!-- Top Bar 2: Abas de Qualidade & Filtros -->
            <RowDefinition Height="*"/>    <!-- Content: Grade Virtualizada, Loupe ou Dashboard -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR 1: LOGO HOME, ABERTURA, RECURSOS E LIGHTROOM -->
        <Border Grid.Row="0" Background="#1C1C1C" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo Home clicável e Botões de Abrir -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="LogoHome_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,0" Cursor="Hand"
                            ToolTip="Clique no logo para ir à Apresentação / Iniciar Novo Projeto (Home)">
                        <Border Background="#0B2035" BorderBrush="#2ECC71" BorderThickness="1.5" CornerRadius="6" Padding="8,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="app_icon.png" Width="20" Height="20" Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="MAVI SELECT" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Content="📁 Abrir Pasta..." Style="{StaticResource ToolbarBtn}" Click="BtnOpenFolder_Click"
                            ToolTip="Abre seletor de diretório para iniciar triagem de fotos RAW / JPG"/>
                    <Button Content="🖼️ Abrir Fotos..." Style="{StaticResource ToolbarBtn}" Click="BtnOpenPhotos_Click"
                            ToolTip="Abre arquivos individuais para carregar a pasta correspondente"/>
                </StackPanel>

                <!-- Caminho da Pasta Atual -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="Pasta: " Foreground="#777777" FontSize="11"/>
                    <TextBlock Text="{Binding CurrentDirectory}" Foreground="#E0E0E0" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>

                <!-- Recursos Rápidos: Auto-Advance, Focus Peaking, Ajuda, Exportar e Lightroom -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Alternador Auto-Advance -->
                    <Button Content="{Binding AutoAdvanceLabel}" Style="{StaticResource ToolbarBtn}" Click="BtnAutoAdvance_Click"
                            ToolTip="Auto-Advance: avança imediatamente para a próxima foto ao escolher, rejeitar ou atribuir nota"/>

                    <!-- Focus Peaking (F) -->
                    <Button Content="🎯 Focus Peaking (F)" Click="BtnFocusPeaking_Click"
                            ToolTip="Focus Peaking: destaca com máscara colorida de alto contraste os pontos nítidos da foto (Segure F ou clique)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFocusPeakingActive}" Value="True">
                                        <Setter Property="Background" Value="#104D25"/>
                                        <Setter Property="BorderBrush" Value="#00FF66"/>
                                        <Setter Property="Foreground" Value="#00FF66"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Ajuda / Onboarding (F1) -->
                    <Button Content="❓ Ajuda" Style="{StaticResource ToolbarBtn}" Click="BtnHelp_Click"
                            ToolTip="Abre o Guia de Funcionalidades e Tabela de Atalhos de Teclado"/>

                    <!-- Divisor -->
                    <Border Width="1" Height="16" Background="#333333" Margin="6,0"/>

                    <Button Content="🔍 Alternar Visão (Espaço)" Style="{StaticResource ToolbarBtn}" Click="BtnToggleView_Click"
                            ToolTip="Alterna entre Grade de Fotos e Foto Única em alta resolução"/>
                    <Button Content="📦 Exportar..." Style="{StaticResource ExportBtn}" Click="BtnExportSelected_Click"
                            ToolTip="Copia todas as fotos selecionadas (Pick) e sidecars .xmp para uma nova pasta"/>
                    <Button Content="⚡ Lightroom" Style="{StaticResource LightroomBtn}" Click="BtnSyncLightroom_Click"
                            ToolTip="Envia exclusivamente as fotos selecionadas para o Adobe Lightroom Classic"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA SUPERIOR 2: ABAS DE PRÉ-SELEÇÃO INTELIGENTE, NOTAS E FILTROS EXIF -->
        <Border Grid.Row="1" Background="#151515" BorderBrush="#222222" BorderThickness="0,0,0,1" Padding="12,5">
            <DockPanel LastChildFill="False">
                <!-- Esquerda: Abas de Qualidade & Status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Qualidade:" Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <!-- Aba: Todas -->
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterAll_Click" ToolTip="Exibe todas as fotos da sessão">
                        <TextBlock>
                            <Run Text="Todas ("/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <!-- Aba: Boas / Nítidas -->
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterGood_Click" ToolTip="Fotos com nitidez e exposição aprovadas">
                        <TextBlock Foreground="#2ECC71">
                            <Run Text="✨ Boas ("/><Run Text="{Binding GoodCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <!-- Aba: Embaçadas -->
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterBlurry_Click" ToolTip="Fotos identificadas com perda de foco ou borrão">
                        <TextBlock Foreground="#BB8FCE">
                            <Run Text="🌫️ Embaçadas ("/><Run Text="{Binding BlurryCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <!-- Aba: Muito Escuras -->
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterUnderexposed_Click" ToolTip="Fotos com subexposição severa ou falha de flash">
                        <TextBlock Foreground="#85929E">
                            <Run Text="🌑 Escuras ("/><Run Text="{Binding UnderexposedCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <!-- Aba: Muito Claras -->
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterOverexposed_Click" ToolTip="Fotos com superexposição ou altas luzes estouradas">
                        <TextBlock Foreground="#F5B041">
                            <Run Text="☀️ Estouradas ("/><Run Text="{Binding OverexposedCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <!-- Aba: Rajadas -->
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterBurstStacks_Click" ToolTip="Fotos agrupadas por sequência de disparo contínuo">
                        <TextBlock Foreground="#5DADE2">
                            <Run Text="⚡ Rajadas ("/><Run Text="{Binding BurstCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <!-- Divisor -->
                    <Border Width="1" Height="14" Background="#333333" Margin="8,0"/>

                    <TextBlock Text="Status:" Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>

                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterPicked_Click" ToolTip="Apenas fotos marcadas com Pick (P)">
                        <TextBlock Foreground="#2ECC71">
                            <Run Text="✔ Picks ("/><Run Text="{Binding PickedCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterRejected_Click" ToolTip="Apenas fotos rejeitadas (X)">
                        <TextBlock Foreground="#E74C3C">
                            <Run Text="✖ Rejeitadas ("/><Run Text="{Binding RejectedCount, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </Button>

                    <!-- Divisor -->
                    <Border Width="1" Height="14" Background="#333333" Margin="8,0"/>

                    <TextBlock Text="Notas:" Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterRating5_Click" ToolTip="Filtrar 5 Estrelas">
                        <TextBlock Foreground="#F39C12"><Run Text="★ 5 ("/><Run Text="{Binding Star5Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterRating4_Click" ToolTip="Filtrar 4 Estrelas">
                        <TextBlock Foreground="#F39C12"><Run Text="★ 4 ("/><Run Text="{Binding Star4Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterRating3_Click" ToolTip="Filtrar 3 Estrelas">
                        <TextBlock Foreground="#F39C12"><Run Text="★ 3 ("/><Run Text="{Binding Star3Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterRating2_Click" ToolTip="Filtrar 2 Estrelas">
                        <TextBlock Foreground="#F39C12"><Run Text="★ 2 ("/><Run Text="{Binding Star2Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource FilterChipBtn}" Click="FilterRating1_Click" ToolTip="Filtrar 1 Estrela">
                        <TextBlock Foreground="#F39C12"><Run Text="★ 1 ("/><Run Text="{Binding Star1Count, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                    </Button>
                </StackPanel>

                <!-- Direita: Filtros EXIF (Câmera e Flash) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Filtro Câmera -->
                    <TextBlock Text="Câmera:" Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="6,0,4,0"/>
                    <ComboBox ItemsSource="{Binding CameraList}" SelectedItem="{Binding SelectedCamera}"
                              Width="140" Height="24" FontSize="11" Background="#222222" Foreground="#EEEEEE"
                              ToolTip="Filtra fotos capturadas por um modelo específico de câmera"/>

                    <!-- Filtro Flash -->
                    <TextBlock Text="Flash:" Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <ComboBox SelectedValue="{Binding SelectedFlashFilter}" SelectedValuePath="Content"
                              Width="110" Height="24" FontSize="11" Background="#222222" Foreground="#EEEEEE"
                              ToolTip="Identifica falhas de reciclagem de flash ou fotos sem iluminação">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="⚡ Flash Disparou"/>
                        <ComboBoxItem Content="🚫 Sem Flash"/>
                    </ComboBox>

                    <!-- Indicador de alterações pendentes -->
                    <Border Background="#D35400" CornerRadius="3" Padding="6,2" Margin="10,0,0,0"
                            Visibility="{Binding UnsavedCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FFFFFF">
                            <Run Text="{Binding UnsavedCount, Mode=OneWay}"/><Run Text=" pendentes"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ÁREA PRINCIPAL: WORKSPACE / DASHBOARD / MODAIS -->
        <Grid Grid.Row="2">

            <!-- ESPAÇO DE TRABALHO DA SESSÃO ATIVA (GRADE OU LOUPE) -->
            <Grid Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BoolToVis}}">

                <!-- MODO 1: GRADE VIRTUALIZADA POR LINHAS ADAPTATIVA -->
                <ListBox x:Name="RowsListBox"
                         ItemsSource="{Binding Rows}"
                         Visibility="{Binding IsGridViewMode, Converter={StaticResource BoolToVis}}"
                         Background="#101010"
                         BorderThickness="0"
                         Padding="10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PhotoRowViewModel}">
                            <ItemsControl ItemsSource="{Binding Columns}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PhotoViewModel}">
                                        <!-- CARD DA FOTO COM AURA VISUAL & BADGES INTELIGENTES -->
                                        <Border Width="260" Height="292" Margin="8,4"
                                                Background="#1C1C1C"
                                                BorderBrush="{Binding CardBorderBrush}"
                                                BorderThickness="{Binding CardBorderThickness}"
                                                Effect="{Binding AuraEffect}"
                                                CornerRadius="6"
                                                ClipToBounds="False"
                                                MouseLeftButtonDown="PhotoCard_MouseLeftButtonDown">

                                            <Grid ClipToBounds="True">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>    <!-- Imagem -->
                                                    <RowDefinition Height="Auto"/> <!-- Rodapé: Nome, Estrelas e Botões -->
                                                </Grid.RowDefinitions>

                                                <!-- Área da Imagem e Badges -->
                                                <Border Grid.Row="0" Background="#0C0C0C" CornerRadius="5,5,0,0">
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}"
                                                               Stretch="Uniform"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                                        <!-- Badges Superiores -->
                                                        <DockPanel VerticalAlignment="Top" Margin="6" LastChildFill="False">
                                                            <!-- Badge de Rajada (Burst) à Esquerda -->
                                                            <Border DockPanel.Dock="Left" Background="#1B5E8C" CornerRadius="3" Padding="5,2"
                                                                    Visibility="{Binding IsInBurst, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding BurstBadgeText}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>

                                                            <!-- Badge de Defeito de Qualidade ao Centro/Esquerda -->
                                                            <Border DockPanel.Dock="Left" Background="{Binding QualityBadgeBrush}" CornerRadius="3" Padding="5,2" Margin="4,0,0,0"
                                                                    Visibility="{Binding HasDefect, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding QualityDefectLabel}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>

                                                            <!-- Badge de Status (PICK / REJECT) à Direita -->
                                                            <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeColor}" CornerRadius="3" Padding="5,2">
                                                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#FFFFFF">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value=""/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                                                    <Setter Property="Text" Value="✔ PICK"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                                                    <Setter Property="Text" Value="✖ REJECT"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DockPanel>

                                                        <!-- Faixa de Label de Cor inferior -->
                                                        <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="3"
                                                                Background="{Binding LabelBrush}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Rodapé do Card: Nome, Tamanho, Estrelas e Botões Físicos -->
                                                <Border Grid.Row="1" Background="#1E1E1E" Padding="8,6" CornerRadius="0,0,5,5">
                                                    <StackPanel>
                                                        <!-- Nome do Arquivo e Tamanho -->
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" Foreground="#EEEEEE"
                                                                       FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" Foreground="#777777"
                                                                       FontSize="10" Margin="4,0,0,0"/>
                                                        </Grid>

                                                        <!-- Estrelas Clicáveis (1 a 5) -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                                            <Button Content="★" Style="{StaticResource StarBtn}" Foreground="{Binding Star1Brush}"
                                                                    Click="CardStar1_Click" ToolTip="1 Estrela"/>
                                                            <Button Content="★" Style="{StaticResource StarBtn}" Foreground="{Binding Star2Brush}"
                                                                    Click="CardStar2_Click" ToolTip="2 Estrelas"/>
                                                            <Button Content="★" Style="{StaticResource StarBtn}" Foreground="{Binding Star3Brush}"
                                                                    Click="CardStar3_Click" ToolTip="3 Estrelas"/>
                                                            <Button Content="★" Style="{StaticResource StarBtn}" Foreground="{Binding Star4Brush}"
                                                                    Click="CardStar4_Click" ToolTip="4 Estrelas"/>
                                                            <Button Content="★" Style="{StaticResource StarBtn}" Foreground="{Binding Star5Brush}"
                                                                    Click="CardStar5_Click" ToolTip="5 Estrelas"/>
                                                        </StackPanel>

                                                        <!-- Botões Físicos Clicáveis (Pick / Reject / Limpar) -->
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0" Content="✔ Escolher" Style="{StaticResource CardPickBtn}"
                                                                    Click="CardBtnPick_Click" ToolTip="Marcar como Pick (P)"/>
                                                            <Button Grid.Column="1" Content="✖ Rejeitar" Style="{StaticResource CardRejectBtn}"
                                                                    Click="CardBtnReject_Click" ToolTip="Marcar como Rejeitada (X)"/>
                                                            <Button Grid.Column="2" Content="↺" Style="{StaticResource CardActionBtn}"
                                                                    Click="CardBtnClear_Click" ToolTip="Limpar marcações (U)"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- MODO 2: FOTO ÚNICA (LOUPE VIEW) COM FOCUS PEAKING -->
                <Grid Visibility="{Binding IsSingleViewMode, Converter={StaticResource BoolToVis}}" Background="#0A0A0A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Barra superior da foto -->
                        <RowDefinition Height="*"/>    <!-- Imagem central + Overlay Peaking -->
                        <RowDefinition Height="Auto"/> <!-- Barra inferior de ações físicas da foto -->
                    </Grid.RowDefinitions>

                    <!-- Barra Superior de Dados da Foto Única -->
                    <Border Grid.Row="0" Background="#CC181818" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPhoto.FileName}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedPhoto.Extension}" Foreground="#3498DB" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedPhoto.FormattedSize}" Foreground="#888888" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedPhoto.CameraModel}" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Indicador de Status Central com Aura -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="{Binding SelectedPhoto.StatusBadgeColor}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#FFFFFF">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="NÃO AVALIADA"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPhoto.IsPicked}" Value="True">
                                                        <Setter Property="Text" Value="✔ SELECIONADA (PICK)"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedPhoto.IsRejected}" Value="True">
                                                        <Setter Property="Text" Value="✖ REJEITADA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Badge de Qualidade se houver defeito -->
                                <Border Background="{Binding SelectedPhoto.QualityBadgeBrush}" CornerRadius="4" Padding="6,3" Margin="0,0,8,0"
                                        Visibility="{Binding SelectedPhoto.HasDefect, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding SelectedPhoto.QualityDefectLabel}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="✕ Voltar à Grade (Espaço)" Style="{StaticResource ToolbarBtn}" Click="BtnToggleView_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Imagem em Alta Resolução + Camada de Focus Peaking -->
                    <Border Grid.Row="1" Margin="14"
                            BorderBrush="{Binding SelectedPhoto.CardBorderBrush}"
                            BorderThickness="{Binding SelectedPhoto.CardBorderThickness}"
                            Effect="{Binding SelectedPhoto.AuraEffect}"
                            CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <!-- Imagem Principal -->
                            <Image Source="{Binding LoupeImage}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Máscara de Nitidez Focus Peaking Sobreposta -->
                            <Image Source="{Binding PeakingOverlayImage}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.85"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasPeakingOverlay, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <!-- Barra Inferior de Ações da Foto Única (Botões Físicos) -->
                    <Border Grid.Row="2" Background="#CC181818" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Navegação -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="◀ Anterior (A)" Style="{StaticResource ToolbarBtn}" Click="BtnPrevious_Click"/>
                                <Button Content="Próxima (D) ▶" Style="{StaticResource ToolbarBtn}" Click="BtnNext_Click"/>
                            </StackPanel>

                            <!-- Botões de Ação Físicos Centrais -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="✔ Escolher (P)" Style="{StaticResource CardPickBtn}" Padding="14,6" FontSize="12" Margin="4,0"
                                        Click="LoupePick_Click" ToolTip="Marca foto como Escolhida (P) e avança"/>
                                <Button Content="✖ Rejeitar (X)" Style="{StaticResource CardRejectBtn}" Padding="14,6" FontSize="12" Margin="4,0"
                                        Click="LoupeReject_Click" ToolTip="Marca foto como Rejeitada (X) e avança"/>
                                <Button Content="↺ Limpar (U)" Style="{StaticResource CardActionBtn}" Padding="10,6" FontSize="12" Margin="4,0"
                                        Click="LoupeClear_Click" ToolTip="Limpa marcações desta foto"/>

                                <!-- Ação de Rajada: Escolher esta e rejeitar outras -->
                                <Button Content="⚡ Escolher Esta e Rejeitar Outras da Rajada" Style="{StaticResource ExportBtn}"
                                        Padding="12,6" FontSize="11" Margin="8,0,0,0" Click="LoupeBtnBurstBest_Click"
                                        Visibility="{Binding SelectedPhoto.IsInBurst, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Aprova a foto atual e marca automaticamente todas as outras fotos da mesma rajada como Rejeitadas"/>

                                <!-- Estrelas Clicáveis no Loupe -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Button Content="★" Style="{StaticResource StarBtn}" FontSize="18" Foreground="{Binding SelectedPhoto.Star1Brush}"
                                            Click="LoupeStar1_Click" ToolTip="1 Estrela"/>
                                    <Button Content="★" Style="{StaticResource StarBtn}" FontSize="18" Foreground="{Binding SelectedPhoto.Star2Brush}"
                                            Click="LoupeStar2_Click" ToolTip="2 Estrelas"/>
                                    <Button Content="★" Style="{StaticResource StarBtn}" FontSize="18" Foreground="{Binding SelectedPhoto.Star3Brush}"
                                            Click="LoupeStar3_Click" ToolTip="3 Estrelas"/>
                                    <Button Content="★" Style="{StaticResource StarBtn}" FontSize="18" Foreground="{Binding SelectedPhoto.Star4Brush}"
                                            Click="LoupeStar4_Click" ToolTip="4 Estrelas"/>
                                    <Button Content="★" Style="{StaticResource StarBtn}" FontSize="18" Foreground="{Binding SelectedPhoto.Star5Brush}"
                                            Click="LoupeStar5_Click" ToolTip="5 Estrelas"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Atalhos Direita -->
                            <TextBlock Grid.Column="2" Text="P: Pick | X: Reject | F: Peaking | 1-5: Estrelas" Foreground="#777777" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- BANNER DE ENTRADA QUANDO NENHUMA FOTO ESTÁ CARREGADA -->
                <Grid Visibility="{Binding Photos.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                    <Border Background="#121212" Margin="40" CornerRadius="12" BorderBrush="#252525" BorderThickness="2"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,30">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="app_icon.png" Width="68" Height="68" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="MAVI SELECT" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Arraste e solte sua pasta de fotos RAW / JPG aqui" FontSize="15" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Ou use os botões abaixo para selecionar a pasta ou fotos da sessão." FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="📁 Selecionar Pasta..." Style="{StaticResource ToolbarBtn}" Padding="16,8" Margin="6,0" Click="BtnOpenFolder_Click"/>
                                <Button Content="🖼️ Selecionar Fotos..." Style="{StaticResource ToolbarBtn}" Padding="16,8" Margin="6,0" Click="BtnOpenPhotos_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- TELA DE APRESENTAÇÃO DO SOFTWARE / DASHBOARD CENTRAL -->
            <Grid Background="#E60D0D0D" Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVis}}">
                <Border Background="#1A1A1A" BorderBrush="#2F2F2F" BorderThickness="1.5" CornerRadius="12"
                        Padding="36,30" MaxWidth="680" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="app_icon.png" Width="80" Height="80" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="MAVI SELECT" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Triagem Inteligente de Fotos RAW &amp; Integração Lightroom Classic"
                                   FontSize="14" Foreground="#2ECC71" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                        <TextBlock Text="Selecione as melhores fotos de sessões com milhares de arquivos em velocidade máxima, sem esperar renderização e demosaicização pesada."
                                   FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Margin="0,0,0,24"/>

                        <!-- Ações Centrais do Dashboard -->
                        <StackPanel HorizontalAlignment="Center" Width="380">
                            <!-- Iniciar Novo Projeto -->
                            <Button Style="{StaticResource LightroomBtn}" Padding="18,12" Margin="0,0,0,10" Click="BtnOpenFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁 Iniciar Novo Projeto (Abrir Pasta)" FontSize="14" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <!-- Adicionar Fotos -->
                            <Button Style="{StaticResource ToolbarBtn}" Padding="16,10" Margin="0,0,0,10" Click="BtnOpenPhotos_Click">
                                <TextBlock Text="🖼️ Selecionar Fotos Avulsas..." FontSize="13"/>
                            </Button>

                            <!-- Retornar à Sessão Atual (Se houver fotos) -->
                            <Button Style="{StaticResource ExportBtn}" Padding="16,10" Margin="0,0,0,10" Click="BtnDashboardReturn_Click"
                                    Visibility="{Binding Photos.Count, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🔙 Continuar Triagem da Sessão Atual" FontSize="13" FontWeight="Bold"/>
                            </Button>

                            <!-- Ajuda e Atalhos -->
                            <Button Style="{StaticResource ToolbarBtn}" Padding="14,8" Margin="0,0,0,6" Click="BtnHelp_Click">
                                <TextBlock Text="❓ Ver Guia de Recursos &amp; Atalhos" FontSize="12"/>
                            </Button>
                        </StackPanel>

                        <!-- Resumo da Sessão se Carregada -->
                        <Border Background="#121212" CornerRadius="8" Padding="16,10" Margin="0,20,0,0" BorderBrush="#252525" BorderThickness="1"
                                Visibility="{Binding Photos.Count, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Foreground="#888888" FontSize="11" Margin="8,0"><Run Text="Total: "/><Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFFFF"/></TextBlock>
                                <TextBlock Foreground="#2ECC71" FontSize="11" Margin="8,0"><Run Text="Selecionadas: "/><Run Text="{Binding PickedCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                <TextBlock Foreground="#E74C3C" FontSize="11" Margin="8,0"><Run Text="Rejeitadas: "/><Run Text="{Binding RejectedCount, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                                <TextBlock Foreground="#D35400" FontSize="11" Margin="8,0" Visibility="{Binding UnsavedCount, Converter={StaticResource BoolToVis}}">
                                    <Run Text="Pendentes XMP: "/><Run Text="{Binding UnsavedCount, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MODAL DE AJUDA & ONBOARDING -->
            <Grid Background="#E6000000" Visibility="{Binding IsHelpModalOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#1E1E1E" BorderBrush="#383838" BorderThickness="1.5" CornerRadius="10"
                        Padding="28,24" MaxWidth="720" MaxHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0B2035" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="GUIA DE USO" FontSize="10" FontWeight="Bold" Foreground="#2ECC71"/>
                                </Border>
                                <TextBlock Text="Mavi Select — Recursos &amp; Atalhos de Teclado" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource ToolbarBtn}" Padding="8,4" Click="BtnCloseHelp_Click"/>
                        </DockPanel>

                        <!-- Conteúdo Rolável -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Seção 1: Atalhos -->
                                <Border Background="#161616" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderBrush="#282828" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="⌨️ Atalhos Rápidos de Teclado" FontWeight="Bold" FontSize="13" Foreground="#2ECC71" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="P" FontWeight="Bold" Foreground="#2ECC71" Margin="0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Marcar como Pick (1 Estrela + Rótulo Verde + Aura Verde)" Foreground="#CCCCCC" Margin="0,2"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="X" FontWeight="Bold" Foreground="#E74C3C" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Marcar como Rejeitada (Rótulo Vermelho + Aura Vermelha)" Foreground="#CCCCCC" Margin="0,2"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="U" FontWeight="Bold" Foreground="#EEEEEE" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Limpar marcações (Unflag)" Foreground="#CCCCCC" Margin="0,2"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="1 a 5" FontWeight="Bold" Foreground="#F39C12" Margin="0,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Atribuir 1 a 5 estrelas diretamente" Foreground="#CCCCCC" Margin="0,2"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="F" FontWeight="Bold" Foreground="#00FF66" Margin="0,2"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Focus Peaking: ativa mapa de nitidez instantâneo em tempo real" Foreground="#CCCCCC" Margin="0,2"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Espaço / Enter" FontWeight="Bold" Foreground="#3498DB" Margin="0,2"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Alternar entre Grade de Fotos e Foto Única (Loupe)" Foreground="#CCCCCC" Margin="0,2"/>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Setas / A e D" FontWeight="Bold" Foreground="#EEEEEE" Margin="0,2"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="Navegar para a foto anterior ou próxima" Foreground="#CCCCCC" Margin="0,2"/>

                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Ctrl + S" FontWeight="Bold" Foreground="#1DB954" Margin="0,2"/>
                                            <TextBlock Grid.Row="7" Grid.Column="1" Text="Gravar e sincronizar metadados para o Lightroom Classic" Foreground="#CCCCCC" Margin="0,2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Seção 2: Focus Peaking -->
                                <Border Background="#161616" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderBrush="#282828" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🎯 Indicador Rápido de Nitidez (Focus Peaking)" FontWeight="Bold" FontSize="13" Foreground="#00FF66" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ao ativar a tecla F ou o botão no topo, o Mavi Select projeta uma máscara neon de alto contraste sobre as bordas em foco da imagem. Isso permite confirmar com precisão se os olhos ou o rosto estão cravados no foco sem precisar dar zoom de 100% em cada foto."
                                                   FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Seção 3: Pré-Seleção Inteligente -->
                                <Border Background="#161616" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderBrush="#282828" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🧠 Pré-Seleção Inteligente &amp; Abas de Defeitos" FontWeight="Bold" FontSize="13" Foreground="#BB8FCE" Margin="0,0,0,6"/>
                                        <TextBlock Text="O software avalia automaticamente a variância Laplaciana (nitidez) e os níveis de exposição de cada foto carregada. Utilize as abas de topo para isolar fotos embaçadas, fotos escuras (subexpostas ou falha de reciclagem de flash) e fotos superexpostas."
                                                   FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Seção 4: Rajadas -->
                                <Border Background="#161616" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" BorderBrush="#282828" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Stacking de Rajadas (Burst Mode)" FontWeight="Bold" FontSize="13" Foreground="#5DADE2" Margin="0,0,0,6"/>
                                        <TextBlock Text="Fotos capturadas em frações de segundo são agrupadas em pilhas. No modo Loupe ou na aba de rajadas, clique no botão '⚡ Escolher Esta e Rejeitar Outras da Rajada' para salvar a melhor expressão e rejeitar automaticamente todas as fotos irmãs da sequência."
                                                   FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Seção 5: Lightroom -->
                                <Border Background="#161616" CornerRadius="6" Padding="14,10" BorderBrush="#282828" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="📸 Integração com Adobe Lightroom Classic" FontWeight="Bold" FontSize="13" Foreground="#3498DB" Margin="0,0,0,6"/>
                                        <TextBlock Text="Ao clicar em 'Enviar Selecionadas ao Lightroom', o Mavi Select cria uma subpasta dedicada '_SELECIONADAS_LIGHTROOM' ou grava os sidecars .xmp. O Lightroom abre mostrando exclusivamente suas fotos escolhidas prontas para edição."
                                                   FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Rodapé -->
                        <Button Grid.Row="2" Content="Entendido / Fechar" Style="{StaticResource ToolbarBtn}" HorizontalAlignment="Right"
                                Padding="18,8" Click="BtnCloseHelp_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- OVERLAYS DE CARREGAMENTO & EXPORTAÇÃO -->
            <Grid Background="#CC000000" Visibility="{Binding IsLoadingFolder, Converter={StaticResource BoolToVis}}">
                <Border Background="#222222" CornerRadius="8" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#383838" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,14" Foreground="#3498DB"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Background="#CC000000" Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}">
                <Border Background="#222222" CornerRadius="8" Padding="28,20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#383838" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,14" Foreground="#2ECC71"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MODAL DE ENVIO EXCLUSIVO PARA O LIGHTROOM -->
            <Grid Background="#D9000000" Visibility="{Binding IsLightroomModalOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="#1E1E1E" BorderBrush="#383838" BorderThickness="1" CornerRadius="10"
                        Padding="28,24" MaxWidth="580" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <!-- Título -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Background="#0F7A3E" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                <TextBlock Text="LIGHTROOM CLASSIC" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock Text="Enviar Fotos Selecionadas" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <TextBlock Margin="0,0,0,18" Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap">
                            <Run Text="Você tem "/><Run Text="{Binding SelectedToSendCount, Mode=OneWay}" FontWeight="Bold" Foreground="#2ECC71"/><Run Text=" fotos selecionadas prontas para o Lightroom Classic."/><LineBreak/>
                            <Run Text="Escolha como deseja enviar para a importação do Lightroom:" Foreground="#888888"/>
                        </TextBlock>

                        <!-- Opção 1: Criar pasta com selecionadas (Recomendado) -->
                        <Border Background="#252525" BorderBrush="#2ECC71" BorderThickness="1.5" CornerRadius="6"
                                Padding="14,12" Margin="0,0,0,12" Cursor="Hand"
                                MouseLeftButtonDown="ModalBtnSubfolder_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📁" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Criar pasta '_SELECIONADAS' e Abrir" FontWeight="Bold" FontSize="13" Foreground="#2ECC71"/>
                                        <Border Background="#107C41" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                            <TextBlock Text="RECOMENDADO" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Copia apenas as fotos selecionadas e seus .xmp para uma subpasta. O Lightroom abrirá a tela de importação mostrando EXCLUSIVAMENTE as selecionadas (zero fotos rejeitadas na tela)."
                                               Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Opção 2: Gravar XMP na pasta atual -->
                        <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="6"
                                Padding="14,12" Margin="0,0,0,18" Cursor="Hand"
                                MouseLeftButtonDown="ModalBtnInPlace_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Gravar XMP apenas nas Selecionadas (Pasta Atual)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Mantém todas as fotos na pasta original, gravando 1 Estrela e Rótulo Verde nos .xmp apenas das escolhidas. No Lightroom, filtre por classificação ou use Ctrl+Alt+R."
                                               Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Botão Cancelar -->
                        <Button Content="Cancelar" Style="{StaticResource ToolbarBtn}" HorizontalAlignment="Right"
                                Padding="16,6" Click="ModalBtnCancel_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- BARRA DE STATUS INFERIOR -->
        <Border Grid.Row="3" Background="#0F0F0F" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Foreground="#666666" FontSize="10">
                        <Run Text="ATALHOS: " FontWeight="Bold" Foreground="#888888"/>
                        <Run Text="[P] Pick  |  "/>
                        <Run Text="[X] Reject  |  "/>
                        <Run Text="[U] Limpar  |  "/>
                        <Run Text="[1-5] Estrelas  |  "/>
                        <Run Text="[F] Focus Peaking  |  "/>
                        <Run Text="[Setas] Navegar  |  "/>
                        <Run Text="[Espaço] Loupe  |  "/>
                        <Run Text="[F1] Ajuda"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>