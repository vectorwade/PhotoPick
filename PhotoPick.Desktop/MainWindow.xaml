<Window x:Class="PhotoPick.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhotoPick.Desktop"
        xmlns:vm="clr-namespace:PhotoPick.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="Mavi Select"
        Height="840" Width="1360"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BgWorkspace}"
        Foreground="{DynamicResource TextNormal}"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      CornerRadius="8"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ESTILO ÍCONE VETORIAL COM HOVER PARA BRANCO -->
        <Style x:Key="VectorIconPath" TargetType="Path">
            <Setter Property="Fill" Value="#A3A3A3"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Fill" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILO BOTÃO MODO DE CONTROLE (WELCOME SCREEN) -->
        <Style x:Key="ControlModeBtn" TargetType="Button">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#222222"/>
                                <Setter Property="BorderBrush" TargetName="bd" Value="#3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#181818"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ESTILO BOTÃO TOOLBAR DISCRETO -->
        <Style x:Key="IdeToolBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#252525"/>
                                <Setter Property="BorderBrush" TargetName="bd" Value="#333333"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#1A1A1A"/>
                                <Setter Property="BorderBrush" TargetName="bd" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO CAPTION (MIN, MAX, CLOSE) -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#2A2A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BOTÃO FECHAR CAPTION COM HOVER VERMELHO -->
        <Style x:Key="CloseCaptionBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#C0392B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO DE AÇÃO PRIMÁRIA VERDE -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="BorderBrush" Value="#27AE60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0A1810"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#38E580"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#27AE60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ESTILO BOTÃO LATERAL NAVEGAÇÃO -->
        <Style x:Key="NavListBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#252525"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#1E1E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainWindowRootBorder" CornerRadius="8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" ClipToBounds="True" Background="{DynamicResource BgWorkspace}">
    <Grid Background="{DynamicResource BgWorkspace}">
        <Grid.RowDefinitions>
            <!-- 0: Header / TitleBar customizada (38px) -->
            <RowDefinition Height="38"/>
            <!-- 1: Área de Conteúdo (Workspace ou Overlay) -->
            <RowDefinition Height="*"/>
            <!-- 2: Status Bar Inferior (28px) -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- 0: HEADER / TOP BAR INTEGRADA (ESTILO IDE CURSOR/ANTIGRAVITY)  -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 0: Logo / Home (Esquerda) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 1: Barra de Ações Rápidas (Centro) -->
                    <ColumnDefinition Width="*"/>
                    <!-- 2: Ações Principais (Exportar & Lr Sincronizar) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 3: Controles de Janela (Direita) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Botão Home / Logo Mavi Select -->
                <Button Grid.Column="0" Click="LogoHome_Click"
                        Style="{StaticResource IdeToolBtn}" Padding="8,4" Margin="6,0"
                        ToolTip="Mavi Select • Clique para ir à Tela Inicial / Iniciar Projeto">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="app_icon.png" Width="18" Height="18" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Mavi Select" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Ações Rápidas Centrais (Alternar Visão, Auto-Advance, Tema, Ajuda) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <!-- Alternar Visão Grade / Loupe -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnViewMode_Click" Margin="0,0,4,0"
                            ToolTip="{Binding ViewModeToolTip, Mode=OneWay}">
                        <TextBlock Text="{Binding ViewModeLabel, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource TextNormal}"/>
                    </Button>

                    <!-- Auto-Advance Toggle -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnAutoAdvance_Click" Margin="0,0,4,0"
                            ToolTip="Avançar automaticamente para a próxima foto ao classificar">
                        <TextBlock Text="{Binding AutoAdvanceLabel, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource TextNormal}"/>
                    </Button>

                    <!-- Alternar Tema Claro / Escuro -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnToggleTheme_Click" Margin="0,0,4,0"
                            ToolTip="Alternar entre Modo Escuro e Modo Claro">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ThemeToggleIcon, Mode=OneWay}" FontSize="12" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding ThemeToggleText, Mode=OneWay}" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <!-- Ajuda e Guia -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnHelp_Click"
                            ToolTip="Guia de Recursos, Atalhos de Teclado e Gamepad (F1 ou H)">
                        <TextBlock Text="❓ Ajuda" FontSize="11.5"/>
                    </Button>

                    <!-- Indicador de Licença / Teste (Trial Badge) -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnLicenseInfo_Click" Margin="0,0,4,0"
                            ToolTip="Status da Licença e Ativação do Mavi Select">
                        <Border Background="#1E293B" CornerRadius="12" Padding="8,3" BorderBrush="#3B82F6" BorderThickness="1">
                            <TextBlock Text="{Binding TrialBadgeText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                        </Border>
                    </Button>
                </StackPanel>

                <!-- Ações Principais: Exportar e Lr Sincronizar (Alinhados à Direita) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- Botão Exportar Selecionadas -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnExport_Click" Margin="0,0,6,0"
                            Background="#222222" BorderBrush="#333333" Padding="12,6"
                            ToolTip="Copiar apenas as fotos selecionadas para uma nova pasta ou pendrive">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💾 " FontSize="12"/>
                            <TextBlock Text="Exportar" FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <!-- Botão Sincronizar / Enviar Lightroom (Verde) -->
                    <Button Style="{StaticResource PrimaryActionBtn}" Click="BtnLightroom_Click"
                            ToolTip="Enviar fotos selecionadas diretamente para o Adobe Lightroom Classic">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Lr Sincronizar" FontSize="11.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Controles da Janela (Min, Max, Close) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionBtn}" Click="BtnMinimize_Click" ToolTip="Minimizar">
                        <TextBlock Text="🗕" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="BtnMaximize_Click" ToolTip="Maximizar / Restaurar">
                        <TextBlock Text="🗖" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionBtn}" Click="BtnClose_Click" ToolTip="Fechar">
                        <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- 1: ÁREA PRINCIPAL (LAYOUT BASE DE 3 PAINÉIS)                   -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Painel Esquerdo: Navegação / Pastas (250px) -->
                <ColumnDefinition Width="250" MinWidth="180" MaxWidth="380"/>
                <!-- Divisor Redimensionável -->
                <ColumnDefinition Width="1"/>
                <!-- Área Central: Workspace (Expansível *) -->
                <ColumnDefinition Width="*"/>
                <!-- Divisor Redimensionável -->
                <ColumnDefinition Width="1"/>
                <!-- Painel Direito: Inspetor EXIF & Qualidade (300px) -->
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="450"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================== -->
            <!-- PAINEL ESQUERDO: NAVEGAÇÃO DE DIRETÓRIOS E SESSÕES (250px) -->
            <!-- ========================================================== -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0">
                <DockPanel Margin="12,14,12,12">
                    <!-- Cabeçalho do Painel -->
                    <TextBlock DockPanel.Dock="Top" Text="EXPLORADOR" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" Margin="4,0,0,10"/>

                    <!-- Cartão da Pasta Ativa -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📁 " FontSize="12"/>
                                <TextBlock Text="{Binding CurrentDirectoryName, Mode=OneWay}" FontWeight="SemiBold"
                                           FontSize="12" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentDirectoryPath, Mode=OneWay}" FontSize="10.5"
                                       Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentDirectoryPath, Mode=OneWay}"/>
                        </StackPanel>
                    </Border>

                    <!-- Botão Abrir Pasta -->
                    <Button DockPanel.Dock="Top" Style="{StaticResource IdeToolBtn}" Click="BtnOpenFolder_Click"
                            Background="#252525" BorderBrush="#333333" Margin="0,0,0,16" Padding="10,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📂 " FontSize="12"/>
                            <TextBlock Text="Abrir Nova Pasta..." FontWeight="SemiBold" FontSize="11.5" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>

                    <!-- Filtros Rápidos de Seleção (Grid 2 colunas para evitar cortes) -->
                    <TextBlock DockPanel.Dock="Top" Text="FILTROS DE STATUS" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" Margin="4,0,0,6"/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Button Style="{StaticResource NavListBtn}" Click="FilterAll_Click" HorizontalAlignment="Stretch" Padding="10,7,12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Todas as Fotos" Foreground="{DynamicResource TextNormal}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding TotalCount, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,2,0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavListBtn}" Click="FilterPicked_Click" HorizontalAlignment="Stretch" Padding="10,7,12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✔ " Foreground="#2ECC71"/>
                                    <TextBlock Text="Selecionadas" Foreground="#2ECC71"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PickedCount, Mode=OneWay}" Foreground="#2ECC71" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,2,0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavListBtn}" Click="FilterDoubt_Click" HorizontalAlignment="Stretch" Padding="10,7,12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="❓ " Foreground="#F39C12"/>
                                    <TextBlock Text="Dúvidas" Foreground="#F39C12"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DoubtCount, Mode=OneWay}" Foreground="#F39C12" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,2,0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavListBtn}" Click="FilterRejected_Click" HorizontalAlignment="Stretch" Padding="10,7,12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✖ " Foreground="#E74C3C"/>
                                    <TextBlock Text="Rejeitadas" Foreground="#E74C3C"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding RejectedCount, Mode=OneWay}" Foreground="#E74C3C" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,2,0"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource NavListBtn}" Click="FilterUnflagged_Click" HorizontalAlignment="Stretch" Padding="10,7,12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="○ Não Avaliadas" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding UnflaggedCount, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,2,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Seção: Agrupamento por Formatos de Arquivo de Imagem -->
                    <TextBlock DockPanel.Dock="Top" Text="FORMATOS DE ARQUIVO" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" Margin="4,0,0,6"/>

                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Formats}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavListBtn}" Click="FormatItem_Click" Margin="0,1" HorizontalAlignment="Stretch" Padding="10,7,12,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextNormal}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource BgCardHover}" CornerRadius="4" Padding="6,1"
                                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,2,0">
                                            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Resumo da Sessão / Métricas Rápidas no Rodapé do Painel -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="RESUMO DA SESSÃO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <TextBlock Text="Total Indexadas:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{Binding TotalCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Fotos Escolhidas:" FontSize="11" Foreground="#2ECC71"/>
                                <TextBlock Text="{Binding PickedCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#2ECC71"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Dúvidas para Revisão:" FontSize="11" Foreground="#F39C12"/>
                                <TextBlock Text="{Binding DoubtCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#F39C12"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Fotos Rejeitadas:" FontSize="11" Foreground="#E74C3C"/>
                                <TextBlock Text="{Binding RejectedCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#E74C3C"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Metadados Pendentes:" FontSize="11" Foreground="#3498DB"/>
                                <TextBlock Text="{Binding UnsavedCount, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#3498DB"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Espaço vazio expansível -->
                    <Grid/>
                </DockPanel>
            </Border>

            <!-- Splitter Esquerdo -->
            <GridSplitter Grid.Column="1" Width="1" Background="#2B2B2B" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- ========================================================== -->
            <!-- ÁREA CENTRAL: WORKSPACE DE FOTOS (#141414)                 -->
            <!-- ========================================================== -->
            <Grid Grid.Column="2" Background="{DynamicResource BgWorkspace}">
                <!-- Modo Grade de Fotos -->
                <ListBox x:Name="GridScrollViewer"
                               ItemsSource="{Binding Rows}"
                               Visibility="{Binding IsGridViewMode, Converter={StaticResource BoolToVis}}"
                               Background="Transparent"
                               BorderThickness="0"
                               Padding="12,10"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                               ScrollViewer.CanContentScroll="True"
                               VirtualizingPanel.IsVirtualizing="True"
                               VirtualizingPanel.VirtualizationMode="Recycling"
                               VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding Columns}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- CARD DA FOTO (ESTILO MINIMALISTA COM AURA) -->
                                            <Border Width="250" Height="265" Margin="7,7"
                                                    Background="{Binding CardBackgroundBrush}"
                                                    CornerRadius="6"
                                                    BorderBrush="{Binding CardBorderBrush}"
                                                    BorderThickness="{Binding CardBorderThickness}"
                                                    Effect="{Binding AuraEffect}"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="PhotoCard_MouseLeftButtonDown">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <!-- 0: Imagem e Badges Contextuais Flutuantes -->
                                                        <RowDefinition Height="185"/>
                                                        <!-- 1: Informações e Controles Rápidos -->
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Imagem da Foto -->
                                                    <Border Grid.Row="0" Background="#111111" CornerRadius="6,6,0,0" ClipToBounds="True">
                                                        <Grid>
                                                            <Image Source="{Binding Thumbnail}"
                                                                   Stretch="Uniform"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   RenderOptions.BitmapScalingMode="LowQuality"/>

                                                            <!-- Mini Badges Contextuais Flutuantes (Aparecem apenas se aplicável) -->
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8">
                                                                <!-- Defeito de Nitidez / Foco -->
                                                                <Border Background="#B39B59B6" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                                                        Visibility="{Binding IsBlurry, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="Foto identificada como Fora de Foco / Embaçada">
                                                                    <TextBlock Text="🌫️ Embaçada" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                                <!-- Subexposição -->
                                                                <Border Background="#B32C3E50" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                                                        Visibility="{Binding IsUnderexposed, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="Foto identificada como Muito Escura (Subexposta)">
                                                                    <TextBlock Text="🌑 Escura" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                                <!-- Hiperexposição -->
                                                                <Border Background="#B3E67E22" CornerRadius="4" Padding="5,2" Margin="0,0,4,0"
                                                                        Visibility="{Binding IsOverexposed, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="Foto identificada como Muito Clara (Estourada)">
                                                                    <TextBlock Text="☀️ Clara" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- Badge de Rajada (Burst) no Canto Superior Direito -->
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,8"
                                                                    Background="#B32980B9" CornerRadius="4" Padding="5,2"
                                                                    Visibility="{Binding IsInBurst, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Foto pertencente a uma sequência rápida de disparos">
                                                                <TextBlock Text="{Binding BurstBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>

                                                            <!-- Badge de Status Escolhida / Dúvida / Rejeitada no Canto Inferior Esquerdo -->
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,8"
                                                                    Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2"
                                                                    Visibility="{Binding IsPicked, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="✔ ESCOLHIDA" FontSize="9" FontWeight="Bold" Foreground="#000000"/>
                                                            </Border>
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,8"
                                                                    Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2"
                                                                    Visibility="{Binding IsDoubt, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="❓ DÚVIDA" FontSize="9" FontWeight="Bold" Foreground="#000000"/>
                                                            </Border>
                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,8"
                                                                    Background="{Binding StatusBadgeColor}" CornerRadius="4" Padding="6,2"
                                                                    Visibility="{Binding IsRejected, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="✖ REJEITADA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>

                                                            <!-- Badge de Foto Selecionada Ativa no Canto Inferior Direito -->
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,8"
                                                                    Background="#2980B9" CornerRadius="4" Padding="6,2"
                                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="Foto atualmente selecionada para inspeção">
                                                                <TextBlock Text="● ATIVA" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Barra Inferior do Card (Metadados e Ações) -->
                                                    <Border Grid.Row="1" Background="{DynamicResource BgCard}" Padding="10,8" CornerRadius="0,0,6,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Nome do Arquivo -->
                                                            <DockPanel Grid.Row="0">
                                                                <TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right"
                                                                           FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextNormal}" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                                            </DockPanel>

                                                            <!-- Estrelas Clicáveis e Botões Rápidos -->
                                                            <DockPanel Grid.Row="1" Margin="0,6,0,0">
                                                                <!-- Botões Rápidos de Voto no Card -->
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Button Style="{StaticResource IdeToolBtn}" Padding="5,2" Margin="2,0,0,0"
                                                                            Click="CardBtnPick_Click" ToolTip="Marcar como Escolhida [P]">
                                                                        <TextBlock Text="✔" Foreground="#2ECC71" FontSize="11" FontWeight="Bold"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource IdeToolBtn}" Padding="5,2" Margin="2,0,0,0"
                                                                            Click="CardBtnDoubt_Click" ToolTip="Marcar como Dúvida [D]">
                                                                        <TextBlock Text="❓" Foreground="#F39C12" FontSize="11" FontWeight="Bold"/>
                                                                    </Button>
                                                                    <Button Style="{StaticResource IdeToolBtn}" Padding="5,2" Margin="2,0,0,0"
                                                                            Click="CardBtnReject_Click" ToolTip="Marcar como Rejeitada [X]">
                                                                        <TextBlock Text="✖" Foreground="#E74C3C" FontSize="11" FontWeight="Bold"/>
                                                                    </Button>
                                                                </StackPanel>

                                                                <!-- 5 Estrelas Clicáveis -->
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="★" Foreground="{Binding Star1Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star1_Click"/>
                                                                    <TextBlock Text="★" Foreground="{Binding Star2Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star2_Click"/>
                                                                    <TextBlock Text="★" Foreground="{Binding Star3Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star3_Click"/>
                                                                    <TextBlock Text="★" Foreground="{Binding Star4Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star4_Click"/>
                                                                    <TextBlock Text="★" Foreground="{Binding Star5Brush}" FontSize="14" Cursor="Hand" Margin="0,0,2,0" MouseLeftButtonDown="Star5_Click"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                <!-- Modo Loupe (Visualização de Foto Única / Zoom Interativo 1:1 e Pan com Focus Peaking) -->
                <Grid x:Name="LoupeContainer"
                      Visibility="{Binding IsSingleViewMode, Converter={StaticResource BoolToVis}}"
                      Background="#0A0A0A"
                      ClipToBounds="True"
                      MouseWheel="LoupeContainer_MouseWheel"
                      MouseLeftButtonDown="LoupeContainer_MouseLeftButtonDown"
                      MouseLeftButtonUp="LoupeContainer_MouseLeftButtonUp"
                      MouseMove="LoupeContainer_MouseMove">

                    <!-- Canvas Interativo da Imagem (Suporta Zoom e Pan) -->
                    <Grid x:Name="LoupeImageCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="LoupeScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                                <TranslateTransform x:Name="LoupeTranslateTransform" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Image x:Name="LoupeMainImage"
                               Source="{Binding LoupeImage}"
                               Stretch="Uniform"
                               Cursor="Hand"
                               MouseLeftButtonDown="LoupeImage_MouseLeftButtonDown"
                               MouseLeftButtonUp="LoupeImage_MouseLeftButtonUp"
                               MouseMove="LoupeImage_MouseMove"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Camada de Focus Peaking (Verde Neon) -->
                        <Image Source="{Binding PeakingOverlayImage}"
                               Stretch="Uniform"
                               Opacity="0.85"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasPeakingOverlay, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Barra Flutuante de Controle no Topo do Loupe -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                            Background="#E61E1E1E" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Alternar Zoom 100% / Ajustar -->
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnToggleLoupeZoom_Click" Margin="0,0,6,0"
                                    ToolTip="Alternar entre Ajustar à Tela e Zoom 100% [Tecla Z ou Duplo Clique]">
                                <TextBlock x:Name="LoupeZoomBtnText" Text="🔍 100%" FontSize="11.5"/>
                            </Button>

                            <!-- Botão Focus Peaking -->
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnFocusPeaking_Click" Margin="0,0,6,0"
                                    ToolTip="Destacar bordas em foco com contorno verde neon [Tecla F]">
                                <TextBlock Text="🎯 Focus Peaking" FontSize="11.5"/>
                            </Button>

                            <!-- Botão Manter Esta, Rejeitar o Resto da Rajada -->
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnPickBurstBest_Click" Margin="0,0,6,0"
                                    Visibility="{Binding SelectedPhoto.IsInBurst, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Marca esta foto atual como Escolhida e rejeita automaticamente todas as outras fotos pertencentes à mesma sequência de rajada (burst mode)">
                                <TextBlock Text="⚡ Manter Esta, Rejeitar o Resto da Rajada" FontSize="11.5" Foreground="#F39C12" FontWeight="SemiBold"/>
                            </Button>

                            <Separator Width="1" Height="16" Background="#2B2B2B" Margin="4,0,8,0"/>

                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnLoupePick_Click" Margin="0,0,4,0" ToolTip="Marcar como Escolhida [P]">
                                <TextBlock Text="✔ Escolher [P]" Foreground="#2ECC71" FontSize="11.5"/>
                            </Button>
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnLoupeDoubt_Click" Margin="0,0,4,0" ToolTip="Marcar como Dúvida para Revisão [D]">
                                <TextBlock Text="❓ Dúvida [D]" Foreground="#F39C12" FontSize="11.5"/>
                            </Button>
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnLoupeReject_Click" Margin="0,0,4,0" ToolTip="Marcar como Rejeitada [X]">
                                <TextBlock Text="✖ Rejeitar [X]" Foreground="#E74C3C" FontSize="11.5"/>
                            </Button>
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnLoupeClear_Click" ToolTip="Limpar Seleção [U]">
                                <TextBlock Text="↺ Limpar [U]" FontSize="11.5"/>
                            </Button>
                            <Button Style="{StaticResource IdeToolBtn}" Click="BtnLoupeDelete_Click" Margin="4,0,0,0" ToolTip="Excluir foto do computador e enviar para a lixeira [Tecla Delete]">
                                <TextBlock Text="🗑️ Excluir [Del]" Foreground="#E74C3C" FontSize="11.5"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Splitter Direito -->
            <GridSplitter Grid.Column="3" Width="1" Background="#2B2B2B" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- ========================================================== -->
            <!-- PAINEL DIREITO: INSPETOR EXIF & QUALIDADE (#1E1E1E - 300px)-->
            <!-- ========================================================== -->
            <Border Grid.Column="4" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,14,14,14">
                        <!-- Cabeçalho do Inspetor -->
                        <TextBlock Text="INSPETOR" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12"/>

                        <!-- SEÇÃO 1: FILTROS DE EQUIPAMENTO (CÂMERA E FLASH REESTILIZADOS) -->
                        <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FILTRAR POR EQUIPAMENTO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                                <!-- Filtro de Câmera -->
                                <TextBlock Text="Câmera" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding CameraList}"
                                          SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"
                                          Margin="0,0,0,10"/>

                                <!-- Filtro de Flash -->
                                <TextBlock Text="Disparo de Flash" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding FlashList}"
                                          SelectedItem="{Binding SelectedFlashFilter, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 2: DADOS DA FOTO ATIVA -->
                        <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FOTO SELECIONADA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                <!-- Miniatura Preview Grande -->
                                <Border Height="140" Background="#0A0A0A" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,10">
                                    <Image Source="{Binding SelectedPhoto.Thumbnail, Mode=OneWay}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Nome do Arquivo -->
                                <TextBlock Text="{Binding SelectedPhotoName, Mode=OneWay}"
                                           FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                <!-- Grade de Metadados EXIF e Disparo Completa -->
                                <Border Background="#1A1A1A" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <!-- Câmera -->
                                        <Grid Margin="0,2.5">
                                            <TextBlock Text="Câmera:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoCamera, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}" MaxWidth="170" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                        </Grid>

                                        <!-- Lente -->
                                        <Grid Margin="0,2.5">
                                            <TextBlock Text="Lente:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoLens, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}" MaxWidth="170" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                                        </Grid>

                                        <!-- Exposição (Obturador • Abertura • ISO) -->
                                        <Grid Margin="0,2.5">
                                            <TextBlock Text="Exposição:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoExposure, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="Bold" Foreground="#3498DB"/>
                                        </Grid>

                                        <!-- Distância Focal -->
                                        <Grid Margin="0,2.5">
                                            <TextBlock Text="Dist. Focal:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoFocalLength, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}"/>
                                        </Grid>

                                        <!-- Flash -->
                                        <Grid Margin="0,2.5">
                                            <TextBlock Text="Flash:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoFlash, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextNormal}"/>
                                        </Grid>

                                        <!-- Resolução / Megapixels -->
                                        <Grid Margin="0,2.5">
                                            <TextBlock Text="Resolução:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoDimensions, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource TextNormal}"/>
                                        </Grid>

                                        <!-- Arquivo e Tamanho -->
                                        <Grid Margin="0,2.5">
                                            <TextBlock Text="Arquivo:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoFileInfo, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </Grid>

                                        <!-- Data / Hora -->
                                        <Grid Margin="0,2.5">
                                            <TextBlock Text="Data / Hora:" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding SelectedPhotoDate, Mode=OneWay}" HorizontalAlignment="Right" FontSize="10.5" Foreground="{DynamicResource TextMuted}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 3: ANÁLISE DE QUALIDADE INTELIGENTE -->
                        <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="ANÁLISE DE QUALIDADE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                                <!-- Diagnóstico Geral -->
                                <TextBlock Text="{Binding SelectedPhotoQualityText, Mode=OneWay}"
                                           Foreground="{Binding SelectedPhotoQualityBrush, Mode=OneWay}"
                                           FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <!-- Medidor de Nitidez (Variância Laplaciana) -->
                                <TextBlock Text="Score de Nitidez (Foco)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                <ProgressBar Height="5" Maximum="100" Value="{Binding SelectedPhotoSharpnessPercent, Mode=OneWay}"
                                             Foreground="#2ECC71" Background="#252525" BorderThickness="0" Margin="0,0,0,10"/>

                                <!-- Medidor de Exposição (Luminância) -->
                                <TextBlock Text="Balanço de Exposição" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,3"/>
                                <ProgressBar Height="5" Maximum="100" Value="{Binding SelectedPhotoBrightnessPercent, Mode=OneWay}"
                                             Foreground="#3498DB" Background="#252525" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- SEÇÃO 4: AÇÕES DE TRIAGEM RÁPIDA -->
                        <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="CLASSIFICAÇÃO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10"/>

                                <!-- 5 Estrelas Grandes no Inspetor -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star1Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar1_Click"/>
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star2Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar2_Click"/>
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star3Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar3_Click"/>
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star4Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar4_Click"/>
                                    <TextBlock Text="★" Foreground="{Binding SelectedPhoto.Star5Brush, Mode=OneWay}" FontSize="22" Cursor="Hand" Margin="2,0" MouseLeftButtonDown="InspectorStar5_Click"/>
                                </StackPanel>

                                <!-- Botão Pick -->
                                <Button Style="{StaticResource PrimaryActionBtn}" Click="BtnInspectorPick_Click" Margin="0,0,0,6" Padding="0,9"
                                        ToolTip="Marcar como foto Escolhida [Tecla P]">
                                    <TextBlock Text="✔ Escolher Foto [P]" FontSize="12" FontWeight="Bold"/>
                                </Button>

                                <!-- Botão Dúvida -->
                                <Button Style="{StaticResource IdeToolBtn}" Background="#2A2210" BorderBrush="#554420" Click="BtnInspectorDoubt_Click" Margin="0,0,0,6" Padding="0,8"
                                        ToolTip="Marcar como Dúvida para Revisão [Tecla D]">
                                    <TextBlock Text="❓ Dúvida para Revisão [D]" FontSize="12" Foreground="#F39C12" FontWeight="SemiBold"/>
                                </Button>

                                <!-- Botão Reject -->
                                <Button Style="{StaticResource IdeToolBtn}" Background="#2A1616" BorderBrush="#552222" Click="BtnInspectorReject_Click" Margin="0,0,0,6" Padding="0,8"
                                        ToolTip="Marcar como foto Rejeitada [Tecla X]">
                                    <TextBlock Text="✖ Rejeitar Foto [X]" FontSize="12" Foreground="#E74C3C" FontWeight="SemiBold"/>
                                </Button>

                                <!-- Botão Limpar -->
                                <Button Style="{StaticResource IdeToolBtn}" Click="BtnInspectorClear_Click" Padding="0,7"
                                        ToolTip="Limpar estado e notas [Tecla U]">
                                    <TextBlock Text="↺ Limpar Seleção [U]" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </Button>

                                <!-- Botão Excluir Foto (Lixeira do Windows) -->
                                <Button Style="{StaticResource IdeToolBtn}" Background="#251414" BorderBrush="#4A2020" Click="BtnInspectorDelete_Click" Margin="0,6,0,0" Padding="0,8"
                                        ToolTip="Excluir foto do computador e enviar para a lixeira [Tecla Delete]">
                                    <TextBlock Text="🗑️ Excluir Foto [Del]" FontSize="11.5" Foreground="#E74C3C" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- 2: STATUS BAR INFERIOR (28PX)                                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel LastChildFill="True">
                <!-- Status do Gamepad e Teclado (Direita) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GamepadStatusText, Mode=OneWay}" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,14,0"/>
                    <TextBlock Text="Atalhos: [P] Escolher  [D] Dúvida  [X] Rejeitar  [U] Limpar  [1-5] Estrelas  [F] Foco  [Z] Zoom 1:1  [Setas] Navegar"
                               FontSize="10.5" Foreground="#666666"/>
                </StackPanel>

                <!-- Mensagem de Status da Aplicação (Esquerda) -->
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- OVERLAY: WELCOME SCREEN / INICIALIZAÇÃO                        -->
        <!-- ============================================================== -->
        <Grid x:Name="WelcomeOverlayGrid" Grid.Row="1" Grid.RowSpan="2" Background="#F2141414"
              Visibility="{Binding IsWelcomeScreenVisible, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="WelcomeOverlay_MouseLeftButtonDown">
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="36" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="WelcomeCard_MouseLeftButtonDown">
                <Grid>
                    <!-- Botão ✕ Fechar no Canto Superior Direito -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-20,-20,0"
                            Style="{StaticResource CaptionBtn}" Click="BtnWelcomeReturn_Click"
                            ToolTip="Fechar tela inicial e voltar à sessão de fotos [Esc]"
                            Visibility="{Binding Photos.Count, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                    </Button>

                    <StackPanel HorizontalAlignment="Center">
                        <!-- Logotipo Oficial Mavi Select -->
                        <Image Source="app_icon.png" Width="76" Height="76" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Título Oficial -->
                    <TextBlock Text="Mavi Select" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <!-- Descrição Elegante -->
                    <TextBlock Text="Triagem ultrarrápida de fotos para criadores e fotógrafos"
                               FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Botão Principal Verde: Iniciar Novo Projeto (com Miniaturas) -->
                    <Button Style="{StaticResource PrimaryActionBtn}" Click="BtnWelcomeOpenFolder_Click"
                            Padding="24,12" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                            ToolTip="Abre o explorador exibindo todas as fotos com miniaturas para você conferir antes de carregar">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🖼️ " FontSize="14"/>
                            <TextBlock Text="Selecionar Fotos / Ensaio (Ver Miniaturas)" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Botão Secundário: Selecionar Pasta Direta pelo Windows -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnWelcomeFolderOnly_Click"
                            Background="#252525" Padding="16,8" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                            ToolTip="Selecionar uma pasta inteira no modo clássico de diretórios do Windows">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📁 " FontSize="12"/>
                            <TextBlock Text="Selecionar Pasta Direta pelo Windows..." FontSize="11.5" Foreground="{DynamicResource TextNormal}"/>
                        </StackPanel>
                    </Button>

                    <!-- Botão Retornar à Sessão (se houver fotos carregadas) -->
                    <Button Style="{StaticResource IdeToolBtn}" Click="BtnWelcomeReturn_Click"
                            Visibility="{Binding Photos.Count, Converter={StaticResource BoolToVis}}"
                            Background="#252525" Padding="16,8" Margin="0,0,0,18" HorizontalAlignment="Stretch">
                        <TextBlock Text="➔ Retornar à Sessão de Trabalho Atual" FontSize="11.5" Foreground="{DynamicResource TextNormal}" HorizontalAlignment="Center"/>
                    </Button>

                    <TextBlock Text="Ou arraste uma pasta de fotos diretamente para esta tela"
                               FontSize="11" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <!-- Modos de Controle (Mouse, Teclado, Gamepad) -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="MODOS DE CONTROLE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Ícone 1: Mouse -->
                            <Button Style="{StaticResource ControlModeBtn}" ToolTip="Controle pelos cliques na tela">
                                <Path Style="{StaticResource VectorIconPath}"
                                      Data="M 7,2 C 4.24,2 2,4.24 2,7 L 2,13 C 2,15.76 4.24,18 7,18 C 9.76,18 12,15.76 12,13 L 12,7 C 12,4.24 9.76,2 7,2 Z M 6.5,4.5 L 7.5,4.5 C 7.78,4.5 8,4.72 8,5 L 8,8 C 8,8.28 7.78,8.5 7.5,8.5 L 6.5,8.5 C 6.22,8.5 6,8.28 6,8 L 6,5 C 6,4.72 6.22,4.5 6.5,4.5 Z"
                                      Width="18" Height="18"/>
                            </Button>

                            <!-- Ícone 2: Teclado -->
                            <Button Style="{StaticResource ControlModeBtn}" ToolTip="Atalhos de Teclado: [P] Escolher • [D] Dúvida • [X] Rejeitar • [1-5] Estrelas • [F] Foco">
                                <Path Style="{StaticResource VectorIconPath}"
                                      Data="M 1,4 C 0.5,4 0,4.5 0,5 L 0,13 C 0,13.5 0.5,14 1,14 L 17,14 C 17.5,14 18,13.5 18,13 L 18,5 C 18,4.5 17.5,4 17,4 Z M 2,5.5 L 3.5,5.5 L 3.5,7 L 2,7 Z M 4.5,5.5 L 6,5.5 L 6,7 L 4.5,7 Z M 7,5.5 L 8.5,5.5 L 8.5,7 L 7,7 Z M 9.5,5.5 L 11,5.5 L 11,7 L 9.5,7 Z M 12,5.5 L 13.5,5.5 L 13.5,7 L 12,7 Z M 14.5,5.5 L 16,5.5 L 16,7 L 14.5,7 Z M 2,8 L 3.5,8 L 3.5,9.5 L 2,9.5 Z M 4.5,8 L 6,8 L 6,9.5 L 4.5,9.5 Z M 7,8 L 8.5,8 L 8.5,9.5 L 7,9.5 Z M 9.5,8 L 11,8 L 11,9.5 L 9.5,9.5 Z M 12,8 L 13.5,8 L 13.5,9.5 L 12,9.5 Z M 14.5,8 L 16,8 L 16,9.5 L 14.5,9.5 Z M 4,11 L 14,11 L 14,12.5 L 4,12.5 Z"
                                      Width="20" Height="18"/>
                            </Button>

                            <!-- Ícone 3: Gamepad com binding e flyout/popup -->
                            <Button x:Name="BtnGamepadMode" Style="{StaticResource ControlModeBtn}"
                                    Click="BtnGamepadMode_Click"
                                    ToolTip="{Binding GamepadToolTip, Mode=OneWay}"
                                    Opacity="{Binding GamepadIconOpacity, Mode=OneWay}">
                                <Path Data="M 5,3 C 2.5,3 1,4.5 1,7 L 2,14 C 2.2,15.5 3.5,16 5,14.5 L 7.5,12 L 12.5,12 L 15,14.5 C 16.5,16 17.8,15.5 18,14 L 19,7 C 19,4.5 17.5,3 15,3 Z M 5.5,5.5 L 6.5,5.5 L 6.5,7 L 8,7 L 8,8 L 6.5,8 L 6.5,9.5 L 5.5,9.5 L 5.5,8 L 4,8 L 4,7 L 5.5,7 Z M 14.5,5.5 C 15,5.5 15.5,6 15.5,6.5 C 15.5,7 15,7.5 14.5,7.5 C 14,7.5 13.5,7 13.5,6.5 C 13.5,6 14,5.5 14.5,5.5 Z M 13,7.5 C 13.5,7.5 14,8 14,8.5 C 14,9 13.5,9.5 13,9.5 C 12.5,9.5 12,9 12,8.5 C 12,8 12.5,7.5 13,7.5 Z M 16,7.5 C 16.5,7.5 17,8 17,8.5 C 17,9 16.5,9.5 16,9.5 C 15.5,9.5 15,9 15,8.5 C 15,8 15.5,7.5 16,7.5 Z M 14.5,9.5 C 15,9.5 15.5,10 15.5,10.5 C 15.5,11 15,11.5 14.5,11.5 C 14,11.5 13.5,11 13.5,10.5 C 13.5,10 14,9.5 14.5,9.5 Z"
                                      Fill="{Binding GamepadIconBrush, Mode=OneWay}"
                                      Stretch="Uniform" Width="22" Height="19"/>
                            </Button>
                        </StackPanel>

                        <!-- Popup / Flyout com o mapa de botões do Gamepad -->
                        <Popup x:Name="GamepadFlyoutPopup"
                               PlacementTarget="{Binding ElementName=BtnGamepadMode}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="#141414" BorderBrush="#2B2B2B" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14" Margin="0,6,0,0" Width="290">
                                <StackPanel>
                                    <TextBlock Text="MAPA DE BOTÕES DO GAMEPAD" FontSize="10" FontWeight="Bold" Foreground="#2ECC71" Margin="0,0,0,10"/>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="LB / RB ou LT / RT:" Foreground="#A3A3A3" FontSize="11"/>
                                        <TextBlock Text="Foto Anterior / Próxima" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Botão A (Verde):" Foreground="#A3A3A3" FontSize="11"/>
                                        <TextBlock Text="Escolher Foto" HorizontalAlignment="Right" Foreground="#2ECC71" FontWeight="Bold" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Botão B ou X:" Foreground="#A3A3A3" FontSize="11"/>
                                        <TextBlock Text="Rejeitar Foto" HorizontalAlignment="Right" Foreground="#E74C3C" FontWeight="Bold" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="Botão Y:" Foreground="#A3A3A3" FontSize="11"/>
                                        <TextBlock Text="Focus Peaking" HorizontalAlignment="Right" Foreground="#3498DB" FontWeight="SemiBold" FontSize="11"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="D-Pad (Direcional):" Foreground="#A3A3A3" FontSize="11"/>
                                        <TextBlock Text="Navegar na Grade" HorizontalAlignment="Right" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- MODAL DE AJUDA & GUIA DE RECURSOS                              -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Background="#B3000000"
              MouseLeftButtonDown="HelpModalBackdrop_MouseLeftButtonDown"
              Visibility="{Binding IsHelpModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    CornerRadius="8" Padding="24" Width="760" MaxHeight="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="HelpModalCard_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionBtn}" Click="BtnCloseHelp_Click" ToolTip="Fechar Ajuda [Esc]">
                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Central de Ajuda &amp; Guia de Recursos — Mavi Select" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Guia completo de conceitos, ferramentas de triagem, atalhos e fluxo de trabalho." FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Conteúdo com Rolagem -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- 1. O que é Rajada & Descarte Inteligente -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="#3A2C10" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="O QUE É DISPARO EM RAJADA (BURST MODE) &amp; DESCARTE INTELIGENTE" FontSize="11" FontWeight="Bold" Foreground="#F39C12"/>
                                    </StackPanel>
                                    <TextBlock Text="Quando você cobre momentos dinâmicos (como o beijo dos noivos, buquê, esportes ou expressões de crianças), a câmera dispara dezenas de fotos por segundo. Isso gera sequências quase idênticas."
                                               FontSize="11.5" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="• Agrupamento Automático: O Mavi Select analisa os milissegundos dos metadados EXIF e identifica fotos da mesma rajada, exibindo o selo ⚡ Rajada."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Botão 'Manter Esta, Rejeitar o Resto da Rajada': Ao inspecionar a foto com o melhor foco e expressão da sequência, clique neste botão (ou no topo do modo Foto Única). Ele marca esta foto atual como Escolhida [P] e automaticamente REJEITA todas as outras da mesma rajada em um único clique, economizando dezenas de cliques manuais repetitivos!"
                                               FontSize="11" Foreground="#F39C12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. Estados de Triagem -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="ESTADOS DE TRIAGEM (FLAGS DE SELEÇÃO)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="✔ Escolher [P]" FontWeight="Bold" Foreground="#2ECC71"/>
                                        <TextBlock Text="Foto aprovada para entrega final ou edição. Recebe aura verde e classificação ativa." Margin="130,0,0,0" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="❓ Dúvida [D]" FontWeight="Bold" Foreground="#F39C12"/>
                                        <TextBlock Text="Foto para revisão posterior. Quando você fica em dúvida entre 2 ou 3 fotos parecidas e quer decidir depois com calma sem perder o ritmo da triagem." Margin="130,0,0,0" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="✖ Rejeitar [X]" FontWeight="Bold" Foreground="#E74C3C"/>
                                        <TextBlock Text="Foto descartada (olhos fechados, foco perdido, fotos repetidas). Recebe aura vermelha." Margin="130,0,0,0" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="↺ Limpar [U]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Text="Remove qualquer flag e estrelas atribuídas, retornando a foto para o estado 'Não Avaliada'." Margin="130,0,0,0" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Classificação por Estrelas -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CLASSIFICAÇÃO POR ESTRELAS (1 A 5 ESTRELAS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Atribua notas de 1 a 5 usando as teclas [1], [2], [3], [4], [5] ou clicando diretamente sobre as estrelas no painel Inspetor ou no cartão."
                                               FontSize="11" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Alternância (Toggle): Clicar na mesma estrela que a foto já possui (ex: clicar na 3ª estrela de uma foto com 3 estrelas) zera a nota. Você também pode pressionar [0] para remover a pontuação."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Compatibilidade: As notas de estrelas são gravadas diretamente no formato padrão XMP da Adobe, sendo lidas perfeitamente pelo Lightroom Classic."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 4. Inspeção de Foco e Zoom Inteligente -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="INSPEÇÃO DE FOCO, ZOOM INTELIGENTE &amp; NAVEGAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Zoom no Ponto do Cursor [Tecla Z ou Clique na Foto]: Ao clicar sobre a foto no modo Foto Única, o zoom amplia 2.5x diretamente para onde a ponta do mouse está apontando, permitindo conferir a nitidez dos olhos instantaneamente."
                                               FontSize="11" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Arrastar (Pan): Com o zoom ativo, clique e arraste o mouse sobre a imagem para percorrer qualquer detalhe do enquadramento."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Tirar o Zoom (Ajustar à Tela): Dê um clique simples na foto ou clique nas barras pretas ao redor para desarmar o zoom imediatamente."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Navegação por Scroll nas Barras Pretas: Rolar a roda do mouse sobre as barras pretas laterais (ou quando a foto estiver sem zoom) avança e retrocede entre as fotos do ensaio com extrema agilidade."
                                               FontSize="11" Foreground="#3498DB" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• 🎯 Focus Peaking [Tecla F]: Analisa o gradiente de contraste do sensor e desenha um contorno em verde neon exatamente nas bordas em foco crítico, permitindo saber se a foto cravou o foco sem sequer precisar dar zoom."
                                               FontSize="11" Foreground="#2ECC71" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 5. Modos de Visualização e Filtros -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="MODOS DE VISUALIZAÇÃO, GRADE &amp; FILTROS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Grade vs. Foto Única [Espaço ou Duplo Clique]: Alterne entre a visão panorâmica do ensaio e a inspeção minuciosa individual."
                                               FontSize="11" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Filtros de Status (Barra Lateral Esquerda): Isole com 1 clique apenas as fotos Escolhidas, Dúvidas, Rejeitadas ou Não Avaliadas."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Filtros de Formato: No topo da janela, selecione visualizar apenas formatos específicos (ex: apenas arquivos .CR3, .NEF, .ARW ou .JPG)."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Alternar Tema: Alterne entre o tema escuro e claro no botão de sol/lua no topo para adequar ao ambiente de iluminação do seu estúdio."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 6. Exclusão Segura -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="#3A1C1C" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🗑️ EXCLUSÃO SEGURA DE FOTOS (LIXEIRA DO WINDOWS)" FontSize="10" FontWeight="Bold" Foreground="#E74C3C" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Pressione [Del] ou clique em '🗑️ Excluir Foto': O Mavi Select exibe um diálogo de confirmação seguro e move o arquivo original e o sidecar .xmp para a Lixeira do Windows."
                                               FontSize="11" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Recuperação Garantida: O arquivo NÃO é destruído permanentemente; se você excluir algo por engano, basta abrir a Lixeira do Windows e restaurar o arquivo."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 7. Integração Lightroom & Exportação -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="INTEGRAÇÃO COM ADOBE LIGHTROOM CLASSIC &amp; EXPORTAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Sincronizar com Lightroom [Ctrl+S]: Grava todas as suas escolhas, dúvidas, rejeições e estrelas em arquivos sidecar padrão da indústria (.xmp). Ao abrir o catálogo no Lightroom, todas as fotos aparecem exatamente como você classificou."
                                               FontSize="11" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="• Exportar Selecionadas: Permite copiar ou mover apenas as fotos com flag 'Escolhida' para uma subpasta específica (ex: 'Selecionadas_Ensaio')."
                                               FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- 8. Controle Gamepad (Xbox / XInput) -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="🎮 MODO GAMEPAD (JOYSTICK XBOX / XINPUT)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                    <TextBlock Text="• Conecte qualquer controle compatível com XInput e faça a triagem confortavelmente recostado na cadeira:"
                                               FontSize="11" Foreground="{DynamicResource TextNormal}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <Grid Margin="0,2"><TextBlock Text="Gatilhos LB / RB:" Foreground="{DynamicResource TextMuted}" FontSize="11"/><TextBlock Text="Avançar / Voltar Fotos" Margin="120,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,2"><TextBlock Text="Botão A (Verde):" Foreground="{DynamicResource TextMuted}" FontSize="11"/><TextBlock Text="Escolher Foto (Pick)" Margin="120,0,0,0" Foreground="#2ECC71" FontWeight="Bold"/></Grid>
                                    <Grid Margin="0,2"><TextBlock Text="Botão B ou X:" Foreground="{DynamicResource TextMuted}" FontSize="11"/><TextBlock Text="Rejeitar Foto (Reject)" Margin="120,0,0,0" Foreground="#E74C3C" FontWeight="Bold"/></Grid>
                                    <Grid Margin="0,2"><TextBlock Text="Botão Y:" Foreground="{DynamicResource TextMuted}" FontSize="11"/><TextBlock Text="Dúvida para Revisão" Margin="120,0,0,0" Foreground="#F39C12" FontWeight="Bold"/></Grid>
                                    <Grid Margin="0,2"><TextBlock Text="Gatilho RT:" Foreground="{DynamicResource TextMuted}" FontSize="11"/><TextBlock Text="Alternar Zoom 100%" Margin="120,0,0,0" Foreground="#3498DB"/></Grid>
                                </StackPanel>
                            </Border>

                            <!-- 9. Tabela Completa de Atalhos de Teclado -->
                            <Border Background="{DynamicResource BgWorkspace}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="TABELA COMPLETA DE ATALHOS DE TECLADO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3"><TextBlock Text="[P]" FontWeight="Bold" Foreground="#2ECC71"/><TextBlock Text="Marcar como Escolhida (Pick / Aura Verde)" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[D]" FontWeight="Bold" Foreground="#F39C12"/><TextBlock Text="Marcar como Dúvida para Revisão (Aura Dourada)" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[X]" FontWeight="Bold" Foreground="#E74C3C"/><TextBlock Text="Marcar como Rejeitada (Reject / Aura Vermelha)" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[U]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Limpar classificação e notas (Unflag)" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[1 a 5]" FontWeight="Bold" Foreground="#F39C12"/><TextBlock Text="Atribuir classificação de 1 a 5 estrelas" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[0]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Remover classificação de estrelas (zera para 0)" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[Del]" FontWeight="Bold" Foreground="#E74C3C"/><TextBlock Text="Excluir foto (enviar para a Lixeira do Windows)" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[F]" FontWeight="Bold" Foreground="#2ECC71"/><TextBlock Text="Ativar / Desativar Focus Peaking (Contorno Verde Neon)" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[Z]" FontWeight="Bold" Foreground="#3498DB"/><TextBlock Text="Alternar Zoom 100% no cursor do mouse" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[Espaço]" FontWeight="Bold" Foreground="#FFFFFF"/><TextBlock Text="Alternar entre Grade e Visualização de Foto Única" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[Setas]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Navegar entre fotos na grade ou modo foto única" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[Ctrl+O]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Abrir nova pasta de fotos" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[Ctrl+S]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Sincronizar metadados XMP e abrir no Lightroom" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                    <Grid Margin="0,3"><TextBlock Text="[Esc]" FontWeight="Bold" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Fechar esta tela de ajuda ou outros painéis sobrepostos" Margin="60,0,0,0" Foreground="{DynamicResource TextNormal}"/></Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé com Botão Fechar -->
                    <DockPanel Grid.Row="2">
                        <TextBlock Text="Dica: Você também pode fechar esta ajuda pressionando [Esc] ou clicando fora do cartão."
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IdeToolBtn}" Background="#252525" Click="BtnCloseHelp_Click"
                                HorizontalAlignment="Right" Padding="18,8">
                            <TextBlock Text="Entendi, fechar ajuda [Esc]" FontSize="11.5" Foreground="#FFFFFF"/>
                        </Button>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- OVERLAY DE LICENÇA / TRIAL LOCK (ANTIGRAVITY DARK STYLE)       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="9999" Background="#CC000000"
              MouseLeftButtonDown="LicenseOverlayBackdrop_MouseLeftButtonDown"
              Visibility="{Binding IsLicenseOverlayVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#121214" BorderBrush="#2D3748" BorderThickness="1.5"
                    CornerRadius="16" Padding="36,32" Width="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="LicenseCard_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="12" Opacity="0.8"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Fechar (Visível apenas se NÃO estiver travado / avaliação ativa) -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Style="{StaticResource CaptionBtn}" Click="BtnCloseLicense_Click"
                            Visibility="{Binding CanDismissLicenseOverlay, Converter={StaticResource BoolToVis}}"
                            ToolTip="Fechar [Esc]">
                        <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextMuted}"/>
                    </Button>

                    <!-- Cabeçalho / Ícone / Título -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="64" Height="64" CornerRadius="32" 
                                Background="#1A1D24" BorderBrush="#3B82F6" BorderThickness="1.5"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="🔒" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Mavi Select" FontSize="13" FontWeight="SemiBold" Foreground="#3B82F6"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <!-- Título do Estado -->
                        <TextBlock Text="{Binding LicenseLockTitle, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- Subtítulo / Explicação -->
                        <TextBlock Text="{Binding LicenseLockSubtitle, Mode=OneWay}" FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="10,8,10,0" LineHeight="18"/>
                    </StackPanel>

                    <!-- Conteúdo: Machine ID & Chave de Ativação -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,24">
                        <!-- Machine ID -->
                        <TextBlock Text="ID DA MÁQUINA (HARDWARE IDENTIFIER):" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True"
                                     Background="#18181B" Foreground="#E4E4E7" BorderBrush="#27272A" BorderThickness="1"
                                     Padding="12,10" FontSize="13" FontFamily="Consolas, monospace" FontWeight="Bold"
                                     VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource IdeToolBtn}" Click="BtnLockCopyMachineId_Click"
                                    Margin="8,0,0,0" Padding="14,10" Background="#27272A" BorderBrush="#3F3F46">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋 " FontSize="12"/>
                                    <TextBlock Text="Copiar ID" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Chave de Ativação -->
                        <TextBlock Text="CHAVE DE ATIVAÇÃO VITALÍCIA:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding EnteredLicenseKey, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#18181B" Foreground="#60A5FA" BorderBrush="#3B82F6" BorderThickness="1.5"
                                 Padding="12,10" FontSize="13.5" FontFamily="Consolas, monospace" FontWeight="Bold"
                                 VerticalAlignment="Center" CharacterCasing="Upper"/>

                        <!-- Mensagem de Erro (se houver) -->
                        <Border Background="#2D1515" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6"
                                Padding="12,8" Margin="0,12,0,0"
                                Visibility="{Binding HasLicenseError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️ " FontSize="12"/>
                                <TextBlock Text="{Binding LicenseErrorMessage, Mode=OneWay}" FontSize="11.5" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Botões de Ação -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Botão Sair / Fechar -->
                        <Button Grid.Column="0" Style="{StaticResource IdeToolBtn}" Click="BtnLockExit_Click"
                                Margin="0,0,8,0" Padding="16,12" Background="#27272A" BorderBrush="#3F3F46">
                            <TextBlock Text="{Binding LicenseExitButtonText, Mode=OneWay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                        </Button>

                        <!-- Botão Ativar -->
                        <Button Grid.Column="1" Click="BtnLockActivate_Click"
                                Margin="8,0,0,0" Padding="16,12" Background="#2563EB" BorderBrush="#3B82F6" BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🔑 " FontSize="13"/>
                                <TextBlock Text="Ativar Mavi Select" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
